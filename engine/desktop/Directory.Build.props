<Project>
  <PropertyGroup>
    <!-- Set before Microsoft.Common.props so NuGet, XAML generation, and the
         compiler agree on one ignored build tree outside the source folder. -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\build_desktop\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\build_desktop\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
