<Window x:Class="FtdDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FTD Desktop"
        Width="1500"
        Height="930"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Foundational Ternary Dynamics"
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold"
                               FontSize="15" />
                    <TextBlock Text="Windows desktop · WSL2 CUDA"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10" />
                </StackPanel>

                <Border Grid.Column="2"
                        Background="#202532"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="BackendStatusDot"
                                 Width="8"
                                 Height="8"
                                 Fill="#F59E0B"
                                 Margin="0,0,7,0" />
                        <TextBlock x:Name="BackendStatusText"
                                   Text="Starting"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="GpuNameText"
                           Grid.Column="3"
                           Margin="14,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis" />

                <Button x:Name="ReloadButton"
                        Grid.Column="4"
                        Content="Reload UI"
                        Click="ReloadButton_Click" />
                <Button x:Name="RestartButton"
                        Grid.Column="6"
                        Content="Restart engine"
                        Click="RestartButton_Click" />
                <Button x:Name="LogsButton"
                        Grid.Column="8"
                        Content="Logs"
                        Click="LogsButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="LogColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <wv2:WebView2 x:Name="DashboardView"
                          Grid.Column="0"
                          DefaultBackgroundColor="#11131A" />

            <Border Grid.Column="1"
                    Background="#12151D"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="12,0">
                        <TextBlock Text="Engine log"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <Button Content="Close"
                                HorizontalAlignment="Right"
                                Padding="10,4"
                                Click="LogsButton_Click" />
                    </Grid>
                    <TextBox x:Name="LogTextBox"
                             Grid.Row="1"
                             Margin="10,0,10,10"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="#0B0D12"
                             Foreground="#B7C0D7"
                             BorderBrush="{StaticResource BorderBrush}"
                             FontFamily="Consolas"
                             FontSize="11" />
                </Grid>
            </Border>

            <Border x:Name="StartupOverlay"
                    Grid.ColumnSpan="2"
                    Background="#F20D0F15">
                <StackPanel Width="430"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Starting FTD Desktop"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="StartupStatusText"
                               Text="Locating the engine..."
                               Margin="0,14,0,16"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <ProgressBar x:Name="StartupProgress"
                                 Height="4"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource AccentBrush}" />
                    <Button x:Name="RetryButton"
                            Content="Retry"
                            Margin="0,18,0,0"
                            Width="100"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Click="RetryButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#0C0E13"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <TextBlock x:Name="FooterStatusText"
                           Text="Initializing"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10" />
                <TextBlock x:Name="VersionText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10" />
            </Grid>
        </Border>
    </Grid>
</Window>
