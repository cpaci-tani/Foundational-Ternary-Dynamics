<rml>
<head>
    <link type="text/rcss" href="../rcss/ftd.rcss"/>
    <title>FTD Native</title>
</head>
<!-- data-model="shell": bound live to UiSnapshot by native_app (M-UI-3). The
     headless smoke test loads this document with no data model registered; RmlUi
     logs a warning and leaves the bindings unresolved, but all chrome/layout
     still renders, so the smoke test's pixel-coverage assertions still hold. -->
<body data-model="shell">
    <!-- Toolbar lives in its OWN document (toolbar.rml, same shared `shell` model,
         z-index 30) so its scenario-picker popup lays out independently of the
         panels. This spacer reserves the 42dp the toolbar document overlays. -->
    <div id="toolbar-spacer"></div>

    <!-- rail | left instrument panel | resizer | viewport hole | resizer | right panel -->
    <div id="body-row">
        <!-- PANEL RAIL: switches the LEFT instrument/analysis panel. active_panel is
             the single source of truth; select_panel(N) sets it + derives the
             telemetry-demand *_open gates. Text labels (Inter has no icon glyphs). -->
        <div id="rail">
            <span class="rail-btn" data-class-sel="active_panel == 1" data-event-click="select_panel(1)">DIAG</span>
            <span class="rail-btn" data-class-sel="active_panel == 2" data-event-click="select_panel(2)">TEL</span>
            <span class="rail-btn" data-class-sel="active_panel == 3" data-event-click="select_panel(3)">GRAV</span>
            <span class="rail-btn" data-class-sel="active_panel == 4" data-event-click="select_panel(4)">TIME</span>
            <span class="rail-btn" data-class-sel="active_panel == 5" data-event-click="select_panel(5)">TH</span>
            <span class="rail-btn" data-class-sel="active_panel == 6" data-event-click="select_panel(6)">FFT</span>
            <span class="rail-btn" data-class-sel="active_panel == 7" data-event-click="select_panel(7)">CHRT</span>
            <span class="rail-btn" data-class-sel="active_panel == 8" data-event-click="select_panel(8)">FLUX</span>
            <span class="rail-btn" data-class-sel="active_panel == 9" data-event-click="select_panel(9)">DISP</span>
            <span class="rail-btn" data-class-sel="active_panel == 10" data-event-click="select_panel(10)">KNOT</span>
        </div>

        <!-- LEFT instrument panel lives in its OWN document (leftpanel.rml, same
             shared `shell` model, z-index 20) -- the high-frequency panel, now
             isolated so its ~8/s reflow never touches the toolbar/right panel/
             viewport. This spacer reserves its flex slot (width tracks setup_width,
             same as the panel doc, so #resizer-left keeps them aligned). -->
        <div id="setup-spacer" class="panel-spacer" data-style-width="setup_width"></div>

        <!-- draggable splitter: resize the LEFT panel -->
        <div id="resizer-left" class="resizer" data-event-drag="resize_left"></div>

        <!-- transparent: the D3D12 lattice/particle/flux scene renders here -->
        <div id="viewport"></div>

        <!-- draggable splitter: resize the RIGHT panel -->
        <div id="resizer-right" class="resizer" data-event-drag="resize_right"></div>

        <!-- RIGHT panel lives in its OWN document (rightpanel.rml, same shared
             `shell` model, z-index 20). This spacer reserves its flex slot so the
             viewport hole stays sized correctly; the panel document overlays it
             (both bind physics_width, so #resizer-right keeps them aligned). -->
        <div id="physics-spacer" class="panel-spacer" data-style-width="physics_width"></div>
    </div>

    <!-- Status bar lives in a SEPARATE document (statusbar.rml, data-model=
         "status"); this spacer reserves its 27dp bottom strip. -->
    <div id="status-spacer"></div>
</body>
</rml>
