<rml>
<head>
    <link type="text/rcss" href="../rcss/ftd.rcss"/>
    <title>FTD Native</title>
</head>
<!-- data-model="shell": bound live to UiSnapshot by native_app (M-UI-3). The
     headless smoke test loads this document with no data model registered; RmlUi
     logs a warning and leaves the bindings unresolved, but all chrome/layout
     still renders, so the smoke test's pixel-coverage assertions still hold. -->
<body data-model="shell">
    <!-- Toolbar -->
    <div id="toolbar">
        <span class="brand">FTD Engine <span class="ver">native</span></span>
        <div class="tb-group">
            <span class="lbl">Engine</span>
            <span class="select">Scale 0 (Lattice)</span>
        </div>
        <div class="spacer"></div>
        <button class="icon">&#9881;</button>
    </div>

    <!-- Setup | viewport hole | Physics -->
    <div id="body-row">
        <div id="setup" class="panel">
            <div class="panel-title">Setup</div>
            <div class="field"><span class="fl">Scenario</span><span class="select">{{scenario}}</span></div>
            <div class="field"><span class="fl">Lattice</span><span class="select">{{lattice}}</span></div>
            <div class="playbar">
                <button class="btn primary" data-event-click="run()">{{ running ? '&#10073;&#10073; Pause' : '&#9654; Run' }}</button>
                <button class="btn" data-event-click="step()">Step</button>
                <button class="btn" data-event-click="reset()">Reset</button>
            </div>
        </div>

        <!-- transparent: the D3D12 lattice/particle/flux scene renders here -->
        <div id="viewport"></div>

        <div id="physics" class="panel">
            <div class="panel-title">Physics terms</div>
            <div class="toggles">
                <div class="tog" data-for="t : toggles" data-class-on="t.on" data-event-click="toggle(t.name)">
                    <span class="led"></span><span class="lbl">{{t.name}}</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Status bar (bound to UiSnapshot) -->
    <div id="status">
        <span class="dot" data-class-running="running"></span><b>{{ running ? 'Running' : 'Paused' }}</b>
        <span>T: <b>{{tick}}</b></span>
        <span>Particles: <b>{{particle_count}}</b></span>
        <span>Energy: <b>{{total_energy}}</b></span>
        <span>{{physical_time}}</span>
        <div class="spacer"></div>
        <span>{{fps}} fps</span>
        <span class="accent">{{backend}}</span>
    </div>
</body>
</rml>
