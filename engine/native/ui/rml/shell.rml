<rml>
<head>
    <link type="text/rcss" href="../rcss/ftd.rcss"/>
    <title>FTD Native</title>
</head>
<!-- data-model="shell": bound live to UiSnapshot by native_app (M-UI-3). The
     headless smoke test loads this document with no data model registered; RmlUi
     logs a warning and leaves the bindings unresolved, but all chrome/layout
     still renders, so the smoke test's pixel-coverage assertions still hold. -->
<body data-model="shell">
    <!-- Toolbar -->
    <div id="toolbar">
        <span class="brand">FTD Engine <span class="ver">native</span></span>
        <div class="tb-group">
            <span class="lbl">Engine</span>
            <span class="select opt" data-class-sel="active_scale == 0" data-event-click="scale_lattice()">Scale 0 (Lattice)</span>
            <span class="select opt" data-class-sel="active_scale == 1" data-event-click="scale_particles()">Scale 1 (Particles)</span>
        </div>
        <div class="spacer"></div>
        <button class="icon">&#9881;</button>
    </div>

    <!-- Setup | viewport hole | Physics -->
    <div id="body-row">
        <div id="setup" class="panel">
            <div class="panel-title">Setup</div>
            <div class="field"><span class="fl">Scenario</span><span class="select">{{scenario}}</span></div>
            <div class="field"><span class="fl">Lattice</span><span class="select">{{lattice}}</span></div>
            <div class="playbar">
                <button class="btn primary" data-event-click="run()">{{ running ? '&#10073;&#10073; Pause' : '&#9654; Run' }}</button>
                <button class="btn" data-event-click="step()">Step</button>
                <button class="btn" data-event-click="reset()">Reset</button>
            </div>
        </div>

        <!-- transparent: the D3D12 lattice/particle/flux scene renders here -->
        <div id="viewport"></div>

        <!-- Right panel is scale-aware: two sibling blocks, one shown per active
             scale via data-if, so RCSS/data-binding drives the switch (no per-frame
             imperative rebuild). Scale 0 → the term-toggle list; Scale 1 → a
             compact particle readout. Both scales share the telemetry chart. -->
        <div id="physics" class="panel">
            <!-- Scale 0 (Lattice): the physics term-toggles + field overlays -->
            <div class="scale-block" data-if="active_scale == 0">
                <div class="panel-title">Physics terms</div>
                <div class="toggles">
                    <div class="tog" data-for="t : toggles" data-class-on="t.on" data-event-click="toggle(t.name)">
                        <span class="led"></span><span class="lbl">{{t.name}}</span>
                    </div>
                </div>

                <!-- Field overlay selector: draws the chosen lattice field in the
                     3D scene (vectors as arrows, scalars as coloured points). -->
                <div class="panel-title fields-title">Fields</div>
                <div class="fields">
                    <div class="fopt" data-for="f : fields" data-class-sel="f.name == active_field" data-event-click="set_field(f.name)">
                        {{f.label}}
                    </div>
                </div>
            </div>

            <!-- Scale 1 (Particles): a compact ParticleEngine readout -->
            <div class="scale-block" data-if="active_scale == 1">
                <div class="panel-title">Particles</div>
                <div class="readout">
                    <div class="ro"><span class="ro-k">Count</span><span class="ro-v">{{particle_count}}</span></div>
                    <div class="ro"><span class="ro-k">Energy</span><span class="ro-v">{{total_energy}}</span></div>
                    <div class="ro"><span class="ro-k">Kinetic</span><span class="ro-v">{{s1_ke}}</span></div>
                    <div class="ro"><span class="ro-k">Potential</span><span class="ro-v">{{s1_pe}}</span></div>
                    <div class="ro"><span class="ro-k">Scenario</span><span class="ro-v mono">{{scenario}}</span></div>
                </div>
            </div>

            <!-- Telemetry: live total-energy trace (app-side ring buffer → the
                 custom <ftd-chart> element, drawn through the D3D12 UI pipeline). -->
            <div class="telemetry">
                <div class="panel-title">Telemetry — total energy</div>
                <ftd-chart id="energy-chart"/>
            </div>
        </div>
    </div>

    <!-- Status bar (bound to UiSnapshot) -->
    <div id="status">
        <span class="dot" data-class-running="running"></span><b>{{ running ? 'Running' : 'Paused' }}</b>
        <span>T: <b>{{tick}}</b></span>
        <span>Particles: <b>{{particle_count}}</b></span>
        <span>Energy: <b>{{total_energy}}</b></span>
        <span>{{physical_time}}</span>
        <div class="spacer"></div>
        <span>{{fps}} fps</span>
        <span class="accent">{{backend}}</span>
    </div>
</body>
</rml>
