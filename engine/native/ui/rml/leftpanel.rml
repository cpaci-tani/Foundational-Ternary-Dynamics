<rml>
<head>
    <link type="text/rcss" href="../rcss/ftd.rcss"/>
    <title>FTD Left Panel</title>
</head>
<!-- data-model="shell": the SAME shared model as shell.rml. This is the HIGH-
     frequency panel (Diagnostics/Telemetry/.../Knots refresh ~8/s). Splitting it
     into its own document (z-index 20, pinned over the shell's #setup-spacer)
     means a table dirty reflows ONLY this document -- not the toolbar picker, the
     right panel, or the viewport chrome. That is the whole perf win. Width tracks
     setup_width (bound), same as the frame's spacer, so #resizer-left keeps the
     overlay aligned. -->
<body data-model="shell" class="leftpanel-body" data-style-width="setup_width">
            <!-- PINNED: play controls -->
            <div class="playbar">
                <button class="btn primary" data-event-click="run()">{{ running ? '&#10073;&#10073; Pause' : '&#9654; Run' }}</button>
                <button class="btn" data-event-click="step()">Step</button>
                <button class="btn" data-event-click="reset()">Reset</button>
            </div>

            <!-- PINNED: Epistemic-status box — the active scenario's
                 ScenarioMeta.epistemic_status (tag + qualification clause). Hidden
                 when empty (Scale-1 / unknown scenario). -->
            <div class="epi-box" data-if="epi_tag != ''">
                <div class="epi-head">
                    <span class="scn-tag" data-class-tpos="epi_cls == 1" data-class-timp="epi_cls == 2" data-class-tcon="epi_cls == 3" data-class-tneg="epi_cls == 4">{{epi_tag}}</span>
                    <span class="epi-title">{{epi_title}}</span>
                </div>
                <div class="epi-body">{{epi_body}}</div>
            </div>

            <!-- ═══ PANEL 1 — Diagnostics (Min/Max/Avg metric tables) ═══ -->
            <div class="panel-block" data-if="active_scale == 0 && active_panel == 1">
                <div class="panel-title">Diagnostics</div>
                <div class="diag-fresh">
                    <span class="diag-fresh-item">{{diag_fresh_diag}}</span>
                    <span class="diag-fresh-item">{{diag_fresh_audit}}</span>
                </div>
                <div class="diag-sec" data-for="sec : diag_sections">
                    <div class="diag-sectitle">{{sec.title}}</div>
                    <div class="diag-head">
                        <span class="diag-metric">Metric</span>
                        <span class="diag-value">Value</span>
                        <span class="diag-unit">Unit</span>
                        <span class="diag-stat">Min</span>
                        <span class="diag-stat">Max</span>
                        <span class="diag-stat">Avg</span>
                    </div>
                    <div class="diag-row" data-for="r : sec.rows" data-class-pos="r.variant == 1" data-class-neg="r.variant == 2">
                        <span class="diag-metric">{{r.label}}</span>
                        <span class="diag-value">{{r.value}}</span>
                        <span class="diag-unit">{{r.unit}}</span>
                        <span class="diag-stat">{{r.vmin}}</span>
                        <span class="diag-stat">{{r.vmax}}</span>
                        <span class="diag-stat">{{r.vavg}}</span>
                    </div>
                </div>
            </div>

            <!-- ═══ PANEL 2 — Telemetry (diagnostics · audit · lagrangian) ═══ -->
            <div class="panel-block" data-if="active_scale == 0 && active_panel == 2">
                <div class="panel-title">Telemetry</div>
                <div class="tel-body">
                    <div class="tel-ctitle">
                        <span class="tel-name">Diagnostics</span>
                        <span class="tel-prov">{{tel_diag_prov}}</span>
                    </div>
                    <ftd-chart id="chart-diag"/>
                    <div class="tel-legend">
                        <div class="tel-row"><span class="tel-chip s0"></span><span class="tel-lbl">Energy</span><span class="tel-val">{{tel_d_energy}}</span></div>
                        <div class="tel-row"><span class="tel-chip s1"></span><span class="tel-lbl">Manifested</span><span class="tel-val">{{tel_d_manif}}</span></div>
                        <div class="tel-row"><span class="tel-chip s2"></span><span class="tel-lbl">Entropy</span><span class="tel-val">{{tel_d_entropy}}</span></div>
                        <div class="tel-row"><span class="tel-chip s3"></span><span class="tel-lbl">Net charge</span><span class="tel-val">{{tel_d_charge}}</span></div>
                    </div>
                    <div class="tel-ctitle">
                        <span class="tel-name">Conservation</span>
                        <span class="tel-prov">{{tel_audit_prov}}</span>
                    </div>
                    <ftd-chart id="chart-audit"/>
                    <div class="tel-legend">
                        <div class="tel-row"><span class="tel-chip s0"></span><span class="tel-lbl">Accounted E</span><span class="tel-val">{{tel_a_energy}}</span></div>
                        <div class="tel-row"><span class="tel-chip s2"></span><span class="tel-lbl">Drift dE/dt</span><span class="tel-val">{{tel_a_drift}}</span></div>
                        <div class="tel-row"><span class="tel-chip s3"></span><span class="tel-lbl">Gauss resid</span><span class="tel-val">{{tel_a_gauss}}</span></div>
                    </div>
                    <div class="tel-ctitle">
                        <span class="tel-name">Lagrangian</span>
                    </div>
                    <ftd-chart id="chart-lagr"/>
                    <div class="tel-legend">
                        <div class="tel-row"><span class="tel-chip s0"></span><span class="tel-lbl">&#8466; total</span><span class="tel-val">{{tel_l_lag}}</span></div>
                        <div class="tel-row"><span class="tel-chip s4"></span><span class="tel-lbl">&#8459; total</span><span class="tel-val">{{tel_l_ham}}</span></div>
                    </div>
                </div>
            </div>

            <!-- ═══ PANEL 3 — Gravity ═══ -->
            <div class="panel-block" data-if="active_scale == 0 && active_panel == 3">
                <div class="panel-title">Gravity</div>
                <div class="tel-body">
                    <div class="tel-ctitle">
                        <span class="tel-name">Latency field (real Poisson L)</span>
                        <span class="tel-prov">{{grav_prov}}</span>
                    </div>
                    <div class="tel-legend">
                        <div class="tel-row"><span class="tel-lbl">L max (potential)</span><span class="tel-val">{{grav_l_max}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">L mean</span><span class="tel-val">{{grav_l_mean}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">Lapse f = 1&#8722;L&#178;</span><span class="tel-val">{{grav_f_min}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">&#947; max</span><span class="tel-val">{{grav_gamma}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">Time dilation</span><span class="tel-val">{{grav_dilation}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">Active voxels</span><span class="tel-val">{{grav_voxels}}</span></div>
                    </div>
                    <div class="grav-note" data-if="grav_inactive">{{grav_status}}</div>
                    <div class="chart-tt">Latency field L &#183; XY plane</div>
                    <ftd-slice id="grav-slice"/>
                </div>
            </div>

            <!-- ═══ PANEL 4 — Time ═══ -->
            <div class="panel-block" data-if="active_scale == 0 && active_panel == 4">
                <div class="panel-title">Time</div>
                <div class="tel-body">
                    <div class="tel-ctitle">
                        <span class="tel-name">Causal clock d&#964;/dt = &#8730;(1&#8722;L&#178;)</span>
                        <span class="tel-prov">{{time_prov}}</span>
                    </div>
                    <div class="tel-legend">
                        <div class="tel-row"><span class="tel-lbl">Clock rate d&#964;/dt</span><span class="tel-val">{{time_dtau}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">Time dilation</span><span class="tel-val">{{time_dilation}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">&#947; max</span><span class="tel-val">{{time_gamma}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">Lapse f = 1&#8722;L&#178;</span><span class="tel-val">{{time_f}}</span></div>
                    </div>
                    <div class="chart-tt">Latency field L &#183; XY plane</div>
                    <ftd-slice id="time-slice"/>
                </div>
            </div>

            <!-- ═══ PANEL 5 — Thermo ═══ -->
            <div class="panel-block" data-if="active_scale == 0 && active_panel == 5">
                <div class="panel-title">Thermo</div>
                <div class="tel-body">
                    <div class="tel-ctitle">
                        <span class="tel-name">Thermodynamic state (k_B &#8801; 1)</span>
                        <span class="tel-prov">{{therm_prov}}</span>
                    </div>
                    <div class="tel-legend">
                        <div class="tel-row"><span class="tel-lbl">T bath (langevin)</span><span class="tel-val">{{therm_bath}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">T_kin (equipartition)</span><span class="tel-val">{{therm_kin}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">Wave energy</span><span class="tel-val">{{therm_wave}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">Entropy</span><span class="tel-val">{{therm_entropy}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">Manifested sites</span><span class="tel-val">{{therm_manif}}</span></div>
                    </div>
                    <div class="chart-tt">Flux |J| &#183; XY plane</div>
                    <ftd-slice id="therm-slice"/>
                </div>
            </div>

            <!-- ═══ PANEL 6 — Spectrum ═══ -->
            <div class="panel-block" data-if="active_scale == 0 && active_panel == 6">
                <div class="panel-title">Spectrum</div>
                <div class="tel-body">
                    <div class="tel-ctitle">
                        <span class="tel-name">Flux spectrum log E(k)</span>
                        <span class="tel-prov">{{spec_prov}}</span>
                    </div>
                    <ftd-chart id="chart-spectrum"/>
                    <div class="tel-legend">
                        <div class="tel-row"><span class="tel-lbl">Peak |k|</span><span class="tel-val">{{spec_peak_k}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">Total power &#931;|J|&#178;</span><span class="tel-val">{{spec_power}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">Spectral index</span><span class="tel-val">{{spec_slope}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">FFT grid M</span><span class="tel-val">{{spec_grid}}</span></div>
                    </div>
                    <div class="tel-ctitle"><span class="tel-name">Field topology (audit)</span></div>
                    <div class="tel-legend">
                        <div class="tel-row"><span class="tel-lbl">Gauss residual &#931;(divJ&#8722;s)&#178;</span><span class="tel-val">{{spec_gauss}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">Chirality &#931;&#967;</span><span class="tel-val">{{spec_chi}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">E-field energy</span><span class="tel-val">{{spec_efield}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">B-field energy</span><span class="tel-val">{{spec_bfield}}</span></div>
                    </div>
                </div>
            </div>

            <!-- ═══ PANEL 7 — Charts (per-channel time series) ═══ -->
            <div class="panel-block" data-if="active_scale == 0 && active_panel == 7">
                <div class="panel-title">Charts</div>
                <div class="chart-tile">
                    <div class="chart-tt">Flux &amp; Energy</div>
                    <ftd-chart id="chart-c-flux"/>
                </div>
                <div class="chart-tile">
                    <div class="chart-tt">Particles &#183; manifested / + / &#8722;</div>
                    <ftd-chart id="chart-c-parts"/>
                </div>
                <div class="chart-tile">
                    <div class="chart-tt">Net charge</div>
                    <ftd-chart id="chart-c-charge"/>
                </div>
                <div class="chart-tile">
                    <div class="chart-tt">Entropy</div>
                    <ftd-chart id="chart-c-entropy"/>
                </div>
            </div>

            <!-- ═══ PANEL 8 — Flux slices (2D |J| heatmaps) ═══ -->
            <div class="panel-block" data-if="active_scale == 0 && active_panel == 8">
                <div class="panel-title">Flux slices &#183; |J|</div>
                <div class="slice-tile">
                    <div class="chart-tt">YZ plane &#183; x = L/2</div>
                    <ftd-slice id="slice-yz"/>
                </div>
                <div class="slice-tile">
                    <div class="chart-tt">XZ plane &#183; y = L/2</div>
                    <ftd-slice id="slice-xz"/>
                </div>
                <div class="slice-tile">
                    <div class="chart-tt">XY plane &#183; z = L/2</div>
                    <ftd-slice id="slice-xy"/>
                </div>
            </div>

            <!-- ═══ PANEL 9 — Dispersion ω(k) (analytic) ═══ -->
            <div class="panel-block" data-if="active_scale == 0 && active_panel == 9">
                <div class="panel-title">Dispersion &#969;(k)</div>
                <div class="tel-body">
                    <div class="tel-ctitle">
                        <span class="tel-name">Lattice dispersion &#969; = 2c&#183;|sin(k/2)|</span>
                    </div>
                    <ftd-chart id="chart-disp"/>
                    <div class="tel-legend">
                        <div class="tel-row"><span class="tel-chip s0"></span><span class="tel-lbl">&#969;(k)</span><span class="tel-val">0 &#8230; 2c</span></div>
                        <div class="tel-row"><span class="tel-chip s2"></span><span class="tel-lbl">group v = d&#969;/dk</span><span class="tel-val">c &#8230; 0</span></div>
                    </div>
                    <div class="tel-legend">
                        <div class="tel-row"><span class="tel-lbl">Wave speed c</span><span class="tel-val">0.5774 (1/&#8730;3)</span></div>
                        <div class="tel-row"><span class="tel-lbl">Max &#969; at k=&#960;</span><span class="tel-val">1.1547 (2c)</span></div>
                    </div>
                    <div class="epi-body">Optical-only branch: &#969; &#8594; 0 as k &#8594; 0 with no acoustic (linear) mode &#8212; a discrete-lattice signature. Analytic, not engine-sampled.</div>
                </div>
            </div>

            <!-- ═══ PANEL 10 — Knots (engine KnotTracker) ═══ -->
            <div class="panel-block" data-if="active_scale == 0 && active_panel == 10">
                <div class="panel-title">Knots</div>
                <div class="tel-body">
                    <div class="tel-legend">
                        <div class="tel-row"><span class="tel-lbl">Alive knots</span><span class="tel-val">{{knot_alive}}</span></div>
                        <div class="tel-row"><span class="tel-lbl">Net charge &#931; sign</span><span class="tel-val">{{knot_charge}}</span></div>
                    </div>
                    <div class="tel-ctitle"><span class="tel-name">Alive count over time</span></div>
                    <ftd-chart id="chart-knots"/>
                    <div class="tel-legend">
                        <div class="tel-row"><span class="tel-lbl">Lifecycle</span><span class="tel-val">{{knot_lifecycle}}</span></div>
                    </div>
                    <div class="grav-note" data-if="knot_has_note">{{knot_note}}</div>
                    <div class="diag-sec">
                        <div class="diag-sectitle">Top knots (by size)</div>
                        <div class="diag-head">
                            <span class="diag-metric">ID</span>
                            <span class="knot-c">&#177;</span>
                            <span class="diag-stat">Age</span>
                            <span class="diag-stat">Size</span>
                            <span class="diag-stat">Flux</span>
                            <span class="diag-stat">Org</span>
                        </div>
                        <div class="diag-row" data-for="k : knot_rows" data-class-pos="k.sign_cls == 1" data-class-neg="k.sign_cls == 2">
                            <span class="diag-metric">#{{k.id}}</span>
                            <span class="knot-c">{{k.sign}}</span>
                            <span class="diag-stat">{{k.age}}</span>
                            <span class="diag-stat">{{k.size}}</span>
                            <span class="diag-stat">{{k.flux}}</span>
                            <span class="diag-stat">{{k.org}}</span>
                        </div>
                    </div>
                    <div class="epi-body">Engine KnotTracker: connected components of same-sign manifested voxels (s=&#177;1), tracked with persistent ids &#8212; distinct from the web panel's field-line-tangle definition.</div>
                </div>
            </div>

            <!-- PINNED: click-to-inspect (below the active panel; both scales). -->
            <div class="inspector" data-if="insp_active">
                <div class="insp-head">
                    <span class="insp-title">{{insp_title}}</span>
                    <span class="insp-close" data-event-click="clear_inspect()">&#10005;</span>
                </div>
                <div class="insp-lines">
                    <div class="insp-row" data-for="ln : insp_lines" data-class-hdr="ln.header">
                        <span class="insp-k">{{ln.k}}</span><span class="insp-v">{{ln.v}}</span>
                    </div>
                </div>
                <div class="insp-neigh" data-if="insp_neigh_show">
                    <div class="section-head sub" data-event-click="toggle_insp_neigh()">
                        <span class="section-caret">{{ insp_neigh_open ? '&#9662;' : '&#9656;' }}</span>
                        <span class="section-title">26-neighbour Moore shell</span>
                    </div>
                    <div class="insp-neigh-body" data-if="insp_neigh_open">
                        <div class="insp-neigh-grp">Faces (6)</div>
                        <div class="insp-neigh-grid">
                            <div class="ncell" data-for="c : insp_faces" data-class-npos="c.state == 1" data-class-nneg="c.state == -1" data-event-click="walk_neigh(c.dx, c.dy, c.dz)">
                                <span class="ncell-dir">{{c.dir}}</span><span class="ncell-v">{{c.val}}</span>
                            </div>
                        </div>
                        <div class="insp-neigh-grp">Edges (12)</div>
                        <div class="insp-neigh-grid">
                            <div class="ncell" data-for="c : insp_edges" data-class-npos="c.state == 1" data-class-nneg="c.state == -1" data-event-click="walk_neigh(c.dx, c.dy, c.dz)">
                                <span class="ncell-dir">{{c.dir}}</span><span class="ncell-v">{{c.val}}</span>
                            </div>
                        </div>
                        <div class="insp-neigh-grp">Corners (8)</div>
                        <div class="insp-neigh-grid">
                            <div class="ncell" data-for="c : insp_corners" data-class-npos="c.state == 1" data-class-nneg="c.state == -1" data-event-click="walk_neigh(c.dx, c.dy, c.dz)">
                                <span class="ncell-dir">{{c.dir}}</span><span class="ncell-v">{{c.val}}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
</body>
</rml>
