/* FTD native shell — RCSS (RmlUi 6.x). First-pass theme + layout for M-UI-1.
   Conservative RCSS: flexbox, solid colours, borders, fonts, :hover. No var()/
   calc()/grid (RCSS does not support them). Refine against the vendored RmlUi
   samples once native_rmlui builds. Colours echo the web dashboard (Abyss). */

/* ── base ─────────────────────────────────────────────────────────────── */
body {
    /* Fill the context so the column-flex children can distribute height —
       without a definite body size, `flex: 1` on #body-row cannot expand and
       the status bar rides up under the toolbar. */
    position: absolute;
    left: 0dp; top: 0dp;
    width: 100%;
    height: 100%;
    font-family: Inter;
    font-size: 14dp;
    color: #dfe6f0;
    /* Transparent, NOT #0d1420: the live D3D12 lattice/particle/flux scene is
       drawn by the presenter UNDERNEATH this RmlUi pass, and shows through the
       transparent #viewport hole. An opaque body background would paint over
       the whole window and occlude the scene. Panels/toolbar/status carry their
       own opaque backgrounds, so only the hole reveals the scene. (The headless
       smoke test clears its RT to #0d1420, so the hole region reads the same
       colour there as before — its pixel-coverage assertions are unaffected.) */
    background-color: transparent;
    display: flex;
    flex-direction: column;
}

/* ── toolbar ──────────────────────────────────────────────────────────── */
#toolbar {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 42dp;
    padding: 0dp 14dp;
    background-color: #131c2b;
    border-bottom: 1dp #2b3a50;
}
.brand { font-family: JetBrains Mono; font-weight: bold; font-size: 15dp; }
.brand .ver { color: #6aa8e0; font-weight: normal; font-size: 11dp; margin-left: 6dp; }
.tb-group { display: flex; flex-direction: row; align-items: center; margin-left: 22dp; }
.tb-group .lbl { color: #67788f; font-size: 11dp; margin-right: 8dp; }
.spacer { flex: 1; }

/* toolbar scale-switcher: two clickable options, active one highlighted */
.tb-group .opt {
    margin-right: 6dp;
    padding: 5dp 10dp;
    color: #9fb0c6;
    cursor: pointer;
}
.tb-group .opt:hover { border-color: #3a7ec4; color: #dfe6f0; }
.tb-group .opt.sel {
    border-color: #2f6db0;
    color: #ffffff;
    background-color: #16233a;
}

/* ── the middle row: setup | viewport hole | physics ──────────────────── */
#body-row { display: flex; flex-direction: row; flex: 1 1 0; align-items: stretch; }

.panel {
    flex: 0 0 240dp;   /* fixed-width side panels; the viewport takes the rest */
    width: 240dp;
    padding: 14dp;
    background-color: #131c2b;
    display: flex;
    flex-direction: column;
}
#setup { border-right: 1dp #2b3a50; }
/* The right panel stacks PHYSICS TERMS + FIELDS + telemetry chart + the
   click-to-inspect readout, which together overflow the body-row height. It is
   a flex item stretched to that (definite) row height, so overflow-y:auto turns
   the surplus into a scroll region reachable by wheel (interactive) or
   Element::SetScrollTop (capture) instead of spilling below the window. The
   fixed 240dp width and the sibling #viewport hole are unchanged. */
#physics { border-left: 1dp #2b3a50; overflow-y: auto; }
.panel-title {
    font-family: JetBrains Mono;
    font-size: 10dp;
    color: #67788f;
    text-transform: uppercase;
    letter-spacing: 1dp;
    margin-bottom: 12dp;
}

/* transparent hole — the D3D12 3D scene shows through here */
#viewport { flex: 1 1 0; background-color: transparent; }

/* ── controls ─────────────────────────────────────────────────────────── */
.field { display: flex; flex-direction: column; margin-bottom: 12dp; }
.field .fl { font-size: 10dp; color: #67788f; text-transform: uppercase; margin-bottom: 5dp; }
.select {
    padding: 7dp 11dp;
    background-color: #0f1826;
    border: 1dp #3a4c66;
    border-radius: 4dp;
    color: #dfe6f0;
    font-size: 12dp;
}
.select.mono { font-family: JetBrains Mono; font-size: 11dp; color: #9fb0c6; }

/* ── Setup scenario picker (Scale-0) ───────────────────────────────────── */
/* A searchable, category-grouped list of the ~130 native-catalog scenarios.
   The list is its own bounded scroll region so the Setup panel stays usable
   even with all groups expanded. */
.scn-picker { display: flex; flex-direction: column; flex: 0 1 auto; min-height: 0dp; margin-bottom: 12dp; }
.scn-picker .field { margin-bottom: 8dp; }
/* Collapsible picker header ("Scenarios ▾ <current>") — the always-present row
   that toggles the (DOM-heavy) list open/closed. */
.scn-picker-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 6dp 8dp;
    margin-bottom: 8dp;
    background-color: #0f1826;
    border: 1dp #3a4c66;
    border-radius: 4dp;
    cursor: pointer;
}
.scn-picker-head:hover { border-color: #3a7ec4; }
.scn-picker-head .fl { margin-bottom: 0dp; margin-right: 8dp; }
.scn-picker-head .scn-cur { flex: 1 1 auto; }
.scn-open { display: flex; flex-direction: column; flex: 0 1 auto; min-height: 0dp; }
.scn-search {
    padding: 6dp 9dp;
    margin-bottom: 8dp;
    background-color: #0f1826;
    border: 1dp #3a4c66;
    border-radius: 4dp;
    color: #dfe6f0;
    font-size: 12dp;
}
.scn-search:focus { border-color: #3a7ec4; }
.scn-list {
    display: flex;
    flex-direction: column;
    max-height: 380dp;
    overflow-y: auto;
    padding: 5dp;
    background-color: #0f1826;
    border: 1dp #223047;
    border-radius: 4dp;
}
.scn-group { display: flex; flex-direction: column; margin-bottom: 4dp; }
.scn-group-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 3dp 4dp;
    margin-bottom: 3dp;
    cursor: pointer;
}
.scn-group-head:hover .scn-group-title { color: #dfe6f0; }
.scn-caret { color: #67788f; font-size: 9dp; margin-right: 6dp; }
.scn-group-title {
    flex: 1 1 auto;
    font-family: JetBrains Mono;
    font-size: 9dp;
    color: #67788f;
    text-transform: uppercase;
    letter-spacing: 1dp;
}
.scn-count { font-family: JetBrains Mono; font-size: 9dp; color: #4a5a72; }
.scn-items { display: flex; flex-direction: column; }
.scn-row { display: flex; flex-direction: column; }
.scn-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 4dp 8dp;
    margin-bottom: 2dp;
    border: 1dp #223047;
    border-radius: 8dp;
    color: #9fb0c6;
    font-size: 11dp;
    cursor: pointer;
}
.scn-item:hover { border-color: #3a7ec4; color: #dfe6f0; background-color: #16233a; }
.scn-item.cur { border-color: #2f6db0; color: #ffffff; background-color: #16233a; }
.scn-title { font-size: 11dp; }

.playbar { display: flex; flex-direction: row; margin-top: 6dp; }
.btn {
    padding: 6dp 12dp;
    margin-right: 6dp;
    background-color: #182234;
    border: 1dp #3a4c66;
    border-radius: 4dp;
    color: #dfe6f0;
    font-size: 12dp;
}
.btn:hover { background-color: #21304a; }
.btn.primary { background-color: #2f6db0; border-color: #2f6db0; color: #ffffff; }
.btn.primary:hover { background-color: #3a7ec4; }
.icon { padding: 6dp 9dp; background-color: transparent; border: 0dp; color: #9fb0c6; font-size: 15dp; }

/* ── physics-term toggles ─────────────────────────────────────────────── */
.toggles { display: flex; flex-direction: column; }
.tog {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 4dp 8dp;
    margin-bottom: 4dp;
    border: 1dp #223047;
    border-radius: 12dp;
    color: #9fb0c6;
    font-family: JetBrains Mono;
    font-size: 11dp;
}
.tog .led {
    width: 8dp; height: 8dp;
    border-radius: 4dp;
    background-color: #1a2739;
    border: 1dp #3a4c66;
    margin-right: 8dp;
}
.tog.on { color: #e0e7f1; border-color: #2f6db0; background-color: #16233a; }
.tog.on .led { background-color: #6aa8e0; border-color: #6aa8e0; }
/* Gated: this ENABLED toggle's current combo violates a requires/conflicts rule
   (the engine's validate() would flag it). Amber ring, so an invalid state is
   visible per-row (the banner names the first offending rule). */
.tog.gated { border-color: #c99a3a; background-color: #2a2312; }
.tog.gated .led { background-color: #e0a63a; border-color: #e0a63a; }
/* Toggle row body: label + description subtitle + requires/conflicts metadata,
   stacked to the right of the LED. */
.tog-body { display: flex; flex-direction: column; flex: 1 1 auto; }
.tog-desc {
    color: #6b7d94;
    font-family: Inter;
    font-size: 9dp;
    margin-top: 1dp;
}
.tog-req {
    color: #c99a3a;
    font-family: JetBrains Mono;
    font-size: 8dp;
    margin-top: 1dp;
}

/* ── collapsible control sections (Physics terms / Config & lattice) ───── */
/* The section headers that gate the (DOM-heavy) toggle list + config knobs.
   Collapsed by default so the live DOM stays small (fps). */
.ctl-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 6dp 8dp;
    margin-bottom: 8dp;
    background-color: #0f1826;
    border: 1dp #3a4c66;
    border-radius: 4dp;
    cursor: pointer;
}
.ctl-head:hover { border-color: #3a7ec4; }
.ctl-caret { color: #67788f; font-size: 9dp; margin-right: 8dp; }
.ctl-htitle {
    flex: 1 1 auto;
    font-family: JetBrains Mono;
    font-size: 10dp;
    color: #9fb0c6;
    text-transform: uppercase;
    letter-spacing: 1dp;
}
.ctl-hnote { font-family: JetBrains Mono; font-size: 9dp; color: #4a5a72; }

/* Live validation banner (TermToggles::validate() + CPU gpu-only warnings). */
.vbanner {
    padding: 6dp 9dp;
    margin-bottom: 10dp;
    background-color: #2a1a12;
    border: 1dp #c9743a;
    border-radius: 4dp;
    color: #f0b48a;
    font-family: JetBrains Mono;
    font-size: 10dp;
}

/* Toggle category groups (Core dynamics / Forces & gravity / …). */
.tog-groups { display: flex; flex-direction: column; margin-bottom: 8dp; }
.tog-group { display: flex; flex-direction: column; margin-bottom: 4dp; }
.tog-group-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 3dp 4dp;
    margin-bottom: 4dp;
    cursor: pointer;
}
.tog-group-head:hover .tog-group-title { color: #dfe6f0; }
.tog-group-title {
    flex: 1 1 auto;
    font-family: JetBrains Mono;
    font-size: 9dp;
    color: #67788f;
    text-transform: uppercase;
    letter-spacing: 1dp;
}
.tog-group-count { font-family: JetBrains Mono; font-size: 9dp; color: #4a5a72; }
.tog-items { display: flex; flex-direction: column; }

/* ── config knobs (dt / SOR / boundary / Langevin / … + lattice + reset) ── */
.cfg-rows { display: flex; flex-direction: column; margin-bottom: 8dp; }
.cfg-knob {
    display: flex;
    flex-direction: column;
    padding: 4dp 8dp;
    margin-bottom: 4dp;
    border: 1dp #223047;
    border-radius: 8dp;
    background-color: #0f1826;
}
.cfg-line { display: flex; flex-direction: row; align-items: center; }
.cfg-label {
    flex: 1 1 auto;
    font-family: JetBrains Mono;
    font-size: 10dp;
    color: #9fb0c6;
}
.cfg-nudge {
    display: inline-block;
    width: 18dp;
    text-align: center;
    padding: 1dp 0dp;
    border: 1dp #2f6db0;
    border-radius: 9dp;
    color: #9fb0c6;
    background-color: #12203a;
    font-family: JetBrains Mono;
    font-size: 12dp;
    cursor: pointer;
}
.cfg-nudge:hover { color: #e6edf6; border-color: #6aa8e0; background-color: #18305a; }
.cfg-val {
    color: #e0e7f1;
    font-family: JetBrains Mono;
    font-size: 11dp;
    margin: 0dp 6dp;
    width: 62dp;
    text-align: center;
}
.cfg-hint { color: #4a5a72; font-family: Inter; font-size: 8dp; margin-top: 2dp; }
.cfg-reset {
    padding: 6dp 10dp;
    margin-top: 4dp;
    text-align: center;
    background-color: #182234;
    border: 1dp #3a4c66;
    border-radius: 4dp;
    color: #dfe6f0;
    font-family: JetBrains Mono;
    font-size: 11dp;
    cursor: pointer;
}
.cfg-reset:hover { background-color: #21304a; border-color: #3a7ec4; }

/* ── field overlay panel (7 columns, multi-select) ────────────────────── */
.fields-title { margin-top: 14dp; }
.overlay-cols { display: flex; flex-direction: column; }
.ov-col { display: flex; flex-direction: column; margin-bottom: 8dp; }
/* Collapsible column header (click to expand/collapse the group). */
.ov-col-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 3dp 4dp;
    margin-bottom: 4dp;
    cursor: pointer;
}
.ov-col-head:hover .ov-col-title { color: #dfe6f0; }
.ov-caret { color: #67788f; font-size: 9dp; margin-right: 6dp; }
.ov-col-title {
    font-family: JetBrains Mono;
    font-size: 10dp;
    color: #67788f;
    text-transform: uppercase;
    letter-spacing: 1dp;
}
.ov-list { display: flex; flex-direction: column; }
/* One overlay toggle: LED + label, lit when the overlay is in the active set
   (same affordance as the physics-term toggles). */
/* One overlay entry: the toggle row plus (for active rubber sheets) a slice-
   height nudge, stacked. The .ov-item owns the inter-row spacing. */
.ov-item { display: flex; flex-direction: column; margin-bottom: 3dp; }
.ov {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 4dp 8dp;
    border: 1dp #223047;
    border-radius: 12dp;
    color: #9fb0c6;
    font-family: JetBrains Mono;
    font-size: 11dp;
    cursor: pointer;
}
.ov:hover { border-color: #3a7ec4; color: #dfe6f0; }
.ov .led {
    width: 8dp; height: 8dp;
    border-radius: 4dp;
    background-color: #1a2739;
    border: 1dp #3a4c66;
    margin-right: 8dp;
}
.ov.on { color: #e0e7f1; border-color: #2f6db0; background-color: #16233a; }
.ov.on .led { background-color: #6aa8e0; border-color: #6aa8e0; }

/* Rubber-sheet slice-height control (shown only under an ACTIVE sheet row). */
.ov-height {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 2dp 8dp 1dp 26dp;   /* indented under the row's label */
}
.ov-nudge {
    display: inline-block;
    width: 18dp;
    text-align: center;
    padding: 1dp 0dp;
    border: 1dp #2f6db0;
    border-radius: 9dp;
    color: #9fb0c6;
    background-color: #12203a;
    font-family: JetBrains Mono;
    font-size: 12dp;
    cursor: pointer;
}
.ov-nudge:hover { color: #e6edf6; border-color: #6aa8e0; background-color: #18305a; }
.ov-hval {
    color: #8aa0bd;
    font-family: JetBrains Mono;
    font-size: 10dp;
    margin: 0dp 8dp;
    width: 44dp;
    text-align: center;
}

/* Force render-style selector (one global setting for the four Force overlays). */
.force-style-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 4dp;
    margin-bottom: 6dp;
}
.fs-label {
    color: #67788f;
    font-family: JetBrains Mono;
    font-size: 10dp;
    margin-right: 8dp;
}
.fs-btn {
    display: inline-block;
    padding: 2dp 8dp;
    margin-right: 5dp;
    border: 1dp #223047;
    border-radius: 9dp;
    color: #9fb0c6;
    background-color: #12203a;
    font-family: JetBrains Mono;
    font-size: 10dp;
    cursor: pointer;
}
.fs-btn:hover { color: #e6edf6; border-color: #3a7ec4; background-color: #18305a; }
.fs-btn.on {
    color: #e0e7f1;
    border-color: #2f6db0;
    background-color: #16233a;
}

/* ── scale-aware right panel ───────────────────────────────────────────── */
/* Each per-scale block stacks its title + content; only one is present at a
   time (the other is removed by data-if), so this drives the panel layout.
   flex:0 0 auto keeps each section at its natural height so the surplus
   overflows #physics (and scrolls) instead of the flex column shrinking the
   sections to fit and clipping their content. */
.scale-block { display: flex; flex-direction: column; flex: 0 0 auto; }

/* Scale-1 particle readout: key/value rows. */
.readout { display: flex; flex-direction: column; }
.ro {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 6dp 8dp;
    margin-bottom: 4dp;
    border: 1dp #223047;
    border-radius: 6dp;
    background-color: #0f1826;
}
.ro-k { color: #67788f; font-size: 11dp; text-transform: uppercase; letter-spacing: 1dp; }
.ro-v { color: #e0e7f1; font-family: JetBrains Mono; font-size: 12dp; }
.ro-v.mono { font-size: 10dp; color: #9fb0c6; }

/* ── telemetry hub (diagnostics · audit · lagrangian) ──────────────────── */
/* Sits below the per-scale content. Collapsible: the header reuses the shared
   .ctl-head chrome; the charts + legends live in .tel-body behind data-if so a
   closed section costs ~0 DOM (fps). Each <ftd-chart> draws its coloured series
   through the D3D12 line path; the RCSS frame/background here is chrome (SPEC
   §5). The trace colours are set per-series in C++ (the ChartRegistry) and
   mirrored by the legend-chip classes .s0..s4 below, so legend and trace agree. */
.telemetry { display: flex; flex-direction: column; flex: 0 0 auto; margin-top: 16dp; }
.tel-body { display: flex; flex-direction: column; }
ftd-chart {
    display: block;
    height: 94dp;
    padding: 6dp;
    margin-bottom: 6dp;
    background-color: #0c1420;
    border: 1dp #2b3a50;
    border-radius: 4dp;
    color: #6aa8e0;   /* baseline/opacity reference (per-series colours come from C++) */
}
/* Per-chart title row: the group name + a "t=" freshness tick for that group. */
.tel-ctitle {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 5dp;
}
.tel-name {
    font-family: JetBrains Mono;
    font-size: 10dp;
    color: #9fb0c6;
    text-transform: uppercase;
    letter-spacing: 1dp;
}
.tel-prov { font-family: JetBrains Mono; font-size: 9dp; color: #4a5a72; }
/* Legend: one row per series — colour chip + label + current value. */
.tel-legend { display: flex; flex-direction: column; margin-bottom: 10dp; }
.tel-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 2dp 4dp;
}
.tel-chip {
    width: 9dp; height: 9dp;
    border-radius: 3dp;
    margin-right: 8dp;
    background-color: #6aa8e0;
}
.tel-chip.s0 { background-color: #6aa8e0; }  /* blue   */
.tel-chip.s1 { background-color: #4ecb8a; }  /* green  */
.tel-chip.s2 { background-color: #e0a63a; }  /* amber  */
.tel-chip.s3 { background-color: #e06a6a; }  /* red    */
.tel-chip.s4 { background-color: #a98ae0; }  /* violet */
.tel-lbl { flex: 1 1 auto; font-family: Inter; font-size: 10dp; color: #8aa0bd; }
.tel-val {
    font-family: JetBrains Mono;
    font-size: 10dp;
    color: #e0e7f1;
}

/* ── click-to-inspect readout ──────────────────────────────────────────── */
/* Shown (data-if insp_active) when an entity is picked in the 3D scene. Lives
   in the scrollable right panel below the telemetry chart; a picked voxel
   (Scale 0) or particle (Scale 1) streams its live fields here. */
.inspector { display: flex; flex-direction: column; flex: 0 0 auto; margin-top: 16dp; }
.insp-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8dp;
}
.insp-title {
    font-family: JetBrains Mono;
    font-size: 10dp;
    color: #6aa8e0;
    text-transform: uppercase;
    letter-spacing: 1dp;
}
.insp-close {
    padding: 1dp 7dp;
    color: #9fb0c6;
    border: 1dp #3a4c66;
    border-radius: 4dp;
    font-size: 12dp;
    cursor: pointer;
}
.insp-close:hover { color: #ffffff; border-color: #3a7ec4; background-color: #21304a; }
.insp-lines { display: flex; flex-direction: column; }
.insp-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 4dp 8dp;
    margin-bottom: 3dp;
    border: 1dp #223047;
    border-radius: 6dp;
    background-color: #0f1826;
}
.insp-k { color: #67788f; font-size: 10dp; text-transform: uppercase; letter-spacing: 1dp; }
.insp-v { color: #e0e7f1; font-family: JetBrains Mono; font-size: 11dp; }
/* Group-divider row (InspLine::header): a full-width section label, no chrome,
   so the long full-voxel readout reads in labelled blocks. */
.insp-row.hdr {
    border: 0dp transparent;
    background-color: transparent;
    padding: 6dp 2dp 2dp 2dp;
    margin-bottom: 0dp;
}
.insp-row.hdr .insp-k {
    color: #6aa8e0;
    font-size: 9dp;
    letter-spacing: 1dp;
}
.insp-row.hdr .insp-v { display: none; }

/* ── 26-Moore-neighbour grid (collapsible sub-section of the inspector) ──── */
.insp-neigh { display: flex; flex-direction: column; flex: 0 0 auto; margin-top: 10dp; }
.insp-neigh-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 4dp 2dp;
    color: #6aa8e0;
    font-family: JetBrains Mono;
    font-size: 10dp;
    text-transform: uppercase;
    letter-spacing: 1dp;
    cursor: pointer;
}
.insp-neigh-head:hover { color: #9fd0ff; }
.insp-neigh-caret { margin-right: 6dp; font-size: 9dp; }
.insp-neigh-body { display: flex; flex-direction: column; }
.insp-neigh-grp {
    color: #67788f;
    font-size: 9dp;
    text-transform: uppercase;
    letter-spacing: 1dp;
    margin: 6dp 0dp 3dp 0dp;
}
.insp-neigh-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}
/* One neighbour cell: dir label over a state-glyph + |flux| value. Coloured by
   neighbour state — void (default) dim, + green, − red. */
.ncell {
    display: flex;
    flex-direction: column;
    width: 58dp;
    margin: 0dp 3dp 3dp 0dp;
    padding: 3dp 4dp;
    border: 1dp #223047;
    border-radius: 5dp;
    background-color: #0f1826;
}
.ncell-dir {
    color: #8595ab;
    font-family: JetBrains Mono;
    font-size: 9dp;
    letter-spacing: 1dp;
}
.ncell-v {
    color: #5c6a7e;
    font-family: JetBrains Mono;
    font-size: 10dp;
}
.ncell.npos { border-color: #2f6b3d; background-color: #10241a; }
.ncell.npos .ncell-v { color: #79d295; }
.ncell.nneg { border-color: #7a3340; background-color: #241014; }
.ncell.nneg .ncell-v { color: #e8899a; }

/* ── vertical scrollbar (the overflowing right panel) ──────────────────── */
/* Without explicit sizing RmlUi renders a zero-width (invisible) scrollbar;
   this gives the auto-overflow region a visible thin thumb. Wheel + SetScrollTop
   work regardless — this is chrome only. */
scrollbarvertical {
    width: 9dp;
    background-color: #0c1420;
}
scrollbarvertical sliderbar {
    background-color: #2b3a50;
    border-radius: 4dp;
    margin-left: 2dp;
    margin-right: 1dp;
    min-height: 28dp;
}
scrollbarvertical sliderbar:hover { background-color: #3a4c66; }
scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc { height: 0dp; }

/* ── status bar ───────────────────────────────────────────────────────── */
#status {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 26dp;
    padding: 0dp 14dp;
    background-color: #131c2b;
    border-top: 1dp #2b3a50;
    font-family: JetBrains Mono;
    font-size: 11dp;
    color: #9fb0c6;
}
#status span { margin-right: 16dp; }
#status b { color: #e0e7f1; }
#status .accent { color: #6aa8e0; }
#status .dot { width: 8dp; height: 8dp; border-radius: 4dp; background-color: #67788f; margin-right: 8dp; }
#status .dot.running { background-color: #4ecb8a; }
