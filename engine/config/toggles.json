    { "name": "strong",            "scale": [1],    "category": "extension", "default": false, "label": "Strong Force",        "description": "Yukawa short-range nuclear force",                  "phase": "compute_forces","group": "qcd" },
    { "name": "radiation",         "scale": [1],    "category": "extension", "default": false, "label": "Radiation (PE)",      "description": "Radiation reaction force",                          "phase": "compute_forces","group": "radiation" },
