    { "name": "ionic",             "scale": [2,3],  "category": "core",      "default": true,  "label": "Ionic",               "description": "Coulomb forces between charged atoms",              "phase": "compute_forces","group": "forces" },
    { "name": "van_der_waals",     "scale": [2,3],  "category": "core",      "default": true,  "label": "Van der Waals",       "description": "Lennard-Jones 12-6 interaction",                    "phase": "compute_forces","group": "forces" },
    { "name": "covalent_bonds",    "scale": [2,3],  "category": "core",      "default": true,  "label": "Covalent Bonds",      "description": "Harmonic spring bond forces",                       "phase": "compute_forces","group": "forces" },
    { "name": "auto_bonding",      "scale": [2,3],  "category": "core",      "default": true,  "label": "Auto-Bonding",        "description": "Automatic bond detection from proximity",           "phase": "post_forces",  "group": "chemistry" },
    { "name": "ae_damping",        "scale": [2,3],  "category": "core",      "default": false, "label": "Damping (AE)",        "description": "Energy dissipation (off for conservation)",          "phase": "post_forces",  "group": "dynamics" },
    { "name": "h_bonds",           "scale": [2,3],  "category": "extension", "default": false, "label": "H-Bonds",             "description": "Hydrogen bonding (LJ 10-12)",                       "phase": "compute_forces","group": "chemistry" },
    { "name": "dipole_dipole",     "scale": [2,3],  "category": "extension", "default": false, "label": "Dipole-Dipole",       "description": "Dipole-dipole interaction",                         "phase": "compute_forces","group": "forces" },
    { "name": "angle_strain",      "scale": [2,3],  "category": "extension", "default": false, "label": "Angle Strain",        "description": "VSEPR angle bending forces",                        "phase": "compute_forces","group": "chemistry" },
    { "name": "torsional",         "scale": [2,3],  "category": "extension", "default": false, "label": "Torsional",           "description": "Dihedral torsion forces",                           "phase": "compute_forces","group": "chemistry" },
    { "name": "thermostat",        "scale": [2,3],  "category": "extension", "default": false, "label": "Thermostat",          "description": "Berendsen temperature coupling",                    "phase": "post_forces",  "group": "dynamics" },
    { "name": "electronegativity", "scale": [2,3],  "category": "extension", "default": false, "label": "Electronegativity",   "description": "Charge redistribution by Pauling EN",               "phase": "compute_forces","group": "chemistry" },

    { "name": "sph_gas",           "scale": [5],    "category": "core",      "default": true,  "label": "SPH Gas",             "description": "Smoothed particle hydrodynamics",                   "phase": "compute_sph",  "group": "hydro" },
    { "name": "hubble_expansion",  "scale": [5],    "category": "core",      "default": true,  "label": "Hubble Expansion",    "description": "Friedmann scale factor a(t) evolution",             "phase": "apply_hubble", "group": "cosmology" },
    { "name": "dark_energy",       "scale": [5],    "category": "extension", "default": false, "label": "Dark Energy",         "description": "Cosmological constant Lambda repulsion",            "phase": "apply_dark",   "group": "cosmology" },
    { "name": "dark_matter_halos", "scale": [5],    "category": "extension", "default": false, "label": "DM Halos",            "description": "Dark matter substructure and halo profiles",        "phase": "compute_gravity","group": "cosmology" },
    { "name": "black_hole_accretion","scale":[5],   "category": "extension", "default": false, "label": "BH Accretion",        "description": "Bondi-Hoyle accretion onto black holes",            "phase": "compute_accretion","group": "compact" },
    { "name": "cosmic_radiation",  "scale": [5],    "category": "extension", "default": false, "label": "Cosmic Radiation",    "description": "Radiative cooling and heating",                     "phase": "compute_radiation","group": "radiation" },
    { "name": "star_formation",    "scale": [5],    "category": "extension", "default": false, "label": "Star Formation",      "description": "Jeans criterion gas-to-star conversion",            "phase": "check_star",   "group": "stellar" },
    { "name": "stellar_evolution", "scale": [5],    "category": "extension", "default": false, "label": "Stellar Evolution",   "description": "Mass-dependent Star -> WD/NS/BH transitions",      "phase": "check_stellar","group": "stellar" },
    { "name": "galaxy_mergers",    "scale": [5],    "category": "extension", "default": false, "label": "Galaxy Mergers",      "description": "Chandrasekhar dynamical friction",                  "phase": "compute_friction","group": "dynamics" },
    { "name": "magnetic_fields",   "scale": [5],    "category": "extension", "default": false, "label": "Magnetic Fields",     "description": "Cosmic dynamo B-field evolution",                   "phase": "compute_magnetic","group": "fields" },
    { "name": "radiation_pressure","scale": [5],    "category": "extension", "default": false, "label": "Radiation Pressure",  "description": "Luminosity-driven gas pushing L/(4pi r^2 c)",       "phase": "compute_radiation","group": "radiation" },
    { "name": "relativistic_jets", "scale": [5],    "category": "extension", "default": false, "label": "Relativistic Jets",   "description": "Bipolar jets from BH/Quasar at v ~ c",              "phase": "compute_jets", "group": "compact" },
    { "name": "gravitational_waves","scale":[5],    "category": "extension", "default": false, "label": "Gravitational Waves", "description": "GW emission from compact object mergers",           "phase": "detect_gw",    "group": "cosmology" }
