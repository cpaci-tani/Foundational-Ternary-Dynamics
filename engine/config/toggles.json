{
  "$schema": "ftd-toggle-registry-v1",
  "version": "1.0.0",
  "description": "Every physics toggle across all FTD scales. Single source of truth consumed by C++ (ScaleEngine::get_toggle/set_toggle), WASM bindings, and JS (config/toggles.js). Human coders: add new toggles here when extending physics.",
  "toggles": [
    { "name": "wave_propagation",  "scale": [0],    "category": "core",      "default": true,  "label": "Wave Propagation",    "description": "Laplacian wave equation in phase_read",             "phase": "phase_read",    "group": "dynamics" },
    { "name": "coupling",          "scale": [0],    "category": "core",      "default": true,  "label": "Coupling",            "description": "-g_c * grad(s) source term in phase_read (Term 2 sign, 2026-07-18)",           "phase": "phase_read",    "group": "dynamics" },
    { "name": "damping",           "scale": [0],    "category": "core",      "default": true,  "label": "Damping",             "description": "Rayleigh dissipation in phase_write",               "phase": "phase_write",   "group": "dynamics" },
    { "name": "genesis",           "scale": [0],    "category": "core",      "default": true,  "label": "Genesis",             "description": "Manifestation + evaporation in phase_write",        "phase": "phase_write",   "group": "matter" },
    { "name": "gauss_projection",  "scale": [0],    "category": "core",      "default": true,  "label": "Gauss Projection",    "description": "div(J) = s constraint enforcement",                "phase": "gauss_project", "group": "constraints" },
    { "name": "forces",            "scale": [0],    "category": "core",      "default": true,  "label": "Forces",              "description": "Field-mediated EM + gravity forces",                "phase": "phase_forces",  "group": "forces" },
    { "name": "gravity",           "scale": [0,1,5],"category": "core",      "default": false, "label": "Gravity",             "description": "Gravitational force F = G_N * grad(rho)",           "phase": "phase_forces",  "group": "forces" },
    { "name": "movement",          "scale": [0],    "category": "core",      "default": true,  "label": "Movement",            "description": "Velocity integration + collisions",                 "phase": "phase_movement","group": "dynamics" },
    { "name": "poisson_coulomb",   "scale": [0],    "category": "core",      "default": true,  "label": "Poisson Coulomb",     "description": "SOR-based Coulomb potential solver",                "phase": "phase_forces",  "group": "forces" },
    { "name": "lorentz_force",     "scale": [0],    "category": "core",      "default": false, "label": "Lorentz Force",       "description": "Magnetic force F = alpha * s * (v x B)",            "phase": "phase_forces",  "group": "forces" },
    { "name": "selective_damping", "scale": [0],    "category": "extension", "default": false, "label": "Selective Damping",   "description": "Damp only near particles (vacuum EM lossless)",     "phase": "phase_write",   "group": "dynamics" },
    { "name": "larmor_radiation",  "scale": [0],    "category": "extension", "default": false, "label": "Larmor Radiation",    "description": "Acceleration-dependent damping (classical Larmor)", "phase": "phase_write",   "group": "radiation" },
    { "name": "dual_substrate",    "scale": [0],    "category": "extension", "default": false, "label": "Dual Substrate",      "description": "Left/right flux decomposition (parity)",            "phase": "phase_read",    "group": "substrate" },
    { "name": "confinement",       "scale": [0],    "category": "extension", "default": false, "label": "Confinement",         "description": "Color force confinement (QCD string)",              "phase": "phase_forces",  "group": "qcd" },

    { "name": "coulomb",           "scale": [1],    "category": "core",      "default": true,  "label": "Coulomb",             "description": "Electromagnetic 1/r^2 force",                       "phase": "compute_forces","group": "forces" },
    { "name": "pe_gravity",        "scale": [1],    "category": "core",      "default": true,  "label": "Gravity (PE)",        "description": "Gravitational attraction between particles",        "phase": "compute_forces","group": "forces" },
    { "name": "pe_damping",        "scale": [1],    "category": "core",      "default": true,  "label": "Damping (PE)",        "description": "Energy dissipation for stability",                  "phase": "post_forces",  "group": "dynamics" },
