{
  "name": "@dimforge/rapier3d-compat",
  "collaborators": [
    "Sébastien Crozet <developer@crozet.re>"
  ],
  "description": "3-dimensional physics engine in Rust - official JS bindings. Compatibility package with inlined webassembly as base64.",
  "version": "0.20.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimforge/rapier"
  },
  "files": [
    "runtime"
  ],
  "module": "runtime/rapier.mjs",
  "homepage": "https://rapier.rs",
  "types": "runtime/rapier.d.ts",
  "sideEffects": false,
  "keywords": [
    "physics",
    "dynamics",
    "rigid",
    "real-time",
    "joints"
  ],
  "main": "runtime/rapier.cjs",
  "exports": {
    ".": {
      "types": "./runtime/rapier.d.ts",
      "require": "./runtime/rapier.cjs",
      "import": "./runtime/rapier.mjs"
    }
  }
}
