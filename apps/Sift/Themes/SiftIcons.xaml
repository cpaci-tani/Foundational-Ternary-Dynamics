<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls">

  <Style x:Key="SiftNavPathIconStyle" TargetType="PathIcon">
    <Setter Property="Foreground" Value="{StaticResource SiftMutedBrush}" />
  </Style>

  <Style x:Key="SiftChromeIconButtonStyle" TargetType="controls:SiftIconButton" BasedOn="{StaticResource SecondaryButtonStyle}">
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="IconSize" Value="15" />
    <Setter Property="Label" Value="" />
  </Style>

  <Style x:Key="SiftPinIconButtonStyle" TargetType="controls:SiftIconButton" BasedOn="{StaticResource SiftChromeIconButtonStyle}">
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="IconSize" Value="13" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <Style x:Key="SiftPrimaryIconButtonStyle" TargetType="controls:SiftIconButton" BasedOn="{StaticResource PrimaryButtonStyle}" />
  <Style x:Key="SiftDangerIconButtonStyle" TargetType="controls:SiftIconButton" BasedOn="{StaticResource DangerButtonStyle}" />

</ResourceDictionary>
