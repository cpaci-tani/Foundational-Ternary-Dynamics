<UserControl
    x:Class="Sift.WinUI.Views.SettingsWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:sift="using:Sift.WinUI.Controls">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Spacing="7">
      <TextBlock Text="Settings" Style="{StaticResource WorkspaceTitleStyle}" />
      <TextBlock Text="Interface, monitoring, and restore-point preferences."
                 Style="{StaticResource WorkspaceSubtitleStyle}" MaxWidth="900" HorizontalAlignment="Left" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10" Padding="0,0,8,8">
        <TextBlock Text="SHELL" Style="{StaticResource EyebrowStyle}" Margin="4,0,0,0" />
        <controls:SettingsExpander Header="Workspace and console"
                                   Description="Activity entries for the current session."
                                   IsExpanded="True">
          <controls:SettingsExpander.Items>
            <controls:SettingsCard Header="UI size"
                                   Description="Scales shell content and workspace text. Compact, Default, or Large.">
              <ComboBox x:Name="UiScaleBox" MinWidth="160" SelectionChanged="UiScaleBox_SelectionChanged"
                        AutomationProperties.Name="UI size">
                <ComboBoxItem Content="Compact" />
                <ComboBoxItem Content="Default" />
                <ComboBoxItem Content="Large" />
              </ComboBox>
            </controls:SettingsCard>
            <controls:SettingsCard Header="Show activity console"
                                   Description="Dock it on wide windows; overlay it when space is limited.">
              <ToggleSwitch x:Name="ConsoleVisibleToggle" Toggled="ConsoleVisibleToggle_Toggled"
                            AutomationProperties.Name="Show activity console" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Console width"
                                   Description="Width of the docked activity console.">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="ConsoleWidthText" Style="{StaticResource TypeMetaStyle}"
                           VerticalAlignment="Center" MinWidth="48" />
                <Slider x:Name="ConsoleWidthSlider" Width="180" Minimum="300" Maximum="520"
                        StepFrequency="20" ValueChanged="ConsoleWidthSlider_ValueChanged"
                        AutomationProperties.Name="Activity console width" />
              </StackPanel>
            </controls:SettingsCard>
          </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <TextBlock Text="LIFECYCLE MONITOR" Style="{StaticResource EyebrowStyle}" Margin="4,12,0,0" />
        <controls:SettingsExpander Header="Background history and alerts"
                                   Description="Optional, per-user monitoring. No service, mutation, elevation, downloads, or remote telemetry."
                                   IsExpanded="True">
          <controls:SettingsExpander.Items>
            <controls:SettingsCard Header="Monitor when Sift is closed"
                                   Description="Runs the current-user Sift monitor and keeps a notification-area icon available.">
              <ToggleSwitch x:Name="MonitorWhenClosedToggle" Toggled="MonitorWhenClosedToggle_Toggled"
                            AutomationProperties.Name="Monitor when Sift is closed" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Background hardware sensors"
                                   Description="Opt in to temperature and fan sampling while Sift is closed. No driver is installed.">
              <ToggleSwitch x:Name="BackgroundHardwareToggle" Toggled="BackgroundHardwareToggle_Toggled"
                            AutomationProperties.Name="Background hardware sensors" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Windows notifications"
                                   Description="Off by default. Quiet-hour alerts remain visible inside Sift.">
              <ToggleSwitch x:Name="DashboardNotificationsToggle" Toggled="DashboardNotificationsToggle_Toggled"
                            AutomationProperties.Name="Dashboard notifications" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Local history retention"
                                   Description="Numeric machine aggregates only; 7–90 days.">
              <NumberBox x:Name="DashboardRetentionBox" MinWidth="120" Minimum="7" Maximum="90"
                         SmallChange="1" SpinButtonPlacementMode="Compact"
                         ValueChanged="DashboardRetentionBox_ValueChanged"
                         AutomationProperties.Name="Dashboard history retention days" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Quiet hours"
                                   Description="Alerts are still recorded, but Windows notifications are suppressed.">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TimePicker x:Name="QuietStartPicker" Width="140" ClockIdentifier="24HourClock"
                            TimeChanged="QuietHours_TimeChanged"
                            AutomationProperties.Name="Quiet hours start" />
                <TextBlock Text="to" VerticalAlignment="Center" Style="{StaticResource TypeMetaStyle}" />
                <TimePicker x:Name="QuietEndPicker" Width="140" ClockIdentifier="24HourClock"
                            TimeChanged="QuietHours_TimeChanged"
                            AutomationProperties.Name="Quiet hours end" />
              </StackPanel>
            </controls:SettingsCard>
            <controls:SettingsCard Header="Alert rules"
                                   Description="Enabled rules evaluate local metric history only.">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="AlertRuleCountText" Style="{StaticResource TypeMetaStyle}"
                           VerticalAlignment="Center" />
                <sift:SiftIconButton Icon="Manage" Label="Manage rules" Click="ManageAlertRulesButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
              </StackPanel>
            </controls:SettingsCard>
            <controls:SettingsCard Header="Monitor status"
                                   Description="Pause or resume the current-user background monitor.">
              <StackPanel Spacing="8">
                <TextBlock x:Name="DashboardMonitorStatusText" Text="Checking monitor…"
                           Style="{StaticResource TypeMetaStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <sift:SiftIconButton Icon="Pause" Label="Pause" Click="PauseMonitorButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                  <sift:SiftIconButton Icon="Play" Label="Resume" Click="ResumeMonitorButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
              </StackPanel>
            </controls:SettingsCard>
            <controls:SettingsCard Header="Clear history"
                                   Description="Erase all dashboard metric history and alert records from this account.">
              <sift:SiftIconButton Icon="Clear" Label="Clear history" Click="ClearDashboardHistoryButton_Click"
                      Style="{StaticResource SecondaryButtonStyle}" />
            </controls:SettingsCard>
          </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <TextBlock Text="HOME CHARTS" Style="{StaticResource EyebrowStyle}" Margin="4,12,0,0" />
        <controls:SettingsExpander Header="Dashboard widget charts"
                                   Description="Defaults for Home metric widgets. Each widget keeps its own history range."
                                   IsExpanded="True">
          <controls:SettingsExpander.Items>
            <controls:SettingsCard Header="Show legend"
                                   Description="Series name under large enough metric widgets.">
              <ToggleSwitch x:Name="HomeChartLegendToggle" Toggled="HomeChartLegendToggle_Toggled"
                            AutomationProperties.Name="Show Home widget chart legends" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Show axes"
                                   Description="Light X/Y axes on large enough metric widgets.">
              <ToggleSwitch x:Name="HomeChartAxesToggle" Toggled="HomeChartAxesToggle_Toggled"
                            AutomationProperties.Name="Show Home widget chart axes" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Line smoothing"
                                   Description="Curvature for Home metric sparklines.">
              <ComboBox x:Name="HomeSmoothingBox" MinWidth="160" SelectionChanged="HomeSmoothingBox_SelectionChanged"
                        AutomationProperties.Name="Home widget chart line smoothing">
                <ComboBoxItem Content="None" />
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Medium" />
                <ComboBoxItem Content="High" />
              </ComboBox>
            </controls:SettingsCard>
          </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <TextBlock Text="PERFORMANCE" Style="{StaticResource EyebrowStyle}" Margin="4,12,0,0" />
        <controls:SettingsExpander Header="Sampling and chart history"
                                   Description="Performance sampling interval and chart display."
                                   IsExpanded="True">
          <controls:SettingsExpander.Items>
            <controls:SettingsCard Header="Refresh interval"
                                   Description="Longer intervals reduce monitoring overhead.">
              <ComboBox x:Name="RefreshIntervalBox" MinWidth="160"
                        SelectionChanged="RefreshIntervalBox_SelectionChanged"
                        AutomationProperties.Name="Performance refresh interval">
                <ComboBoxItem Content="1 second" />
                <ComboBoxItem Content="2 seconds" />
                <ComboBoxItem Content="3 seconds" />
                <ComboBoxItem Content="5 seconds" />
              </ComboBox>
            </controls:SettingsCard>
            <controls:SettingsCard Header="History samples"
                                   Description="Keep 30–600 readings.">
              <NumberBox x:Name="HistoryNumberBox" MinWidth="120" Minimum="30" Maximum="600"
                         SmallChange="10" SpinButtonPlacementMode="Compact"
                         ValueChanged="HistoryNumberBox_ValueChanged"
                         AutomationProperties.Name="Performance chart history samples" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Line smoothing"
                                   Description="Curvature applied to the CPU and memory history lines.">
              <ComboBox x:Name="SmoothingBox" MinWidth="160" SelectionChanged="SmoothingBox_SelectionChanged"
                        AutomationProperties.Name="Performance chart line smoothing">
                <ComboBoxItem Content="None" />
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Medium" />
                <ComboBoxItem Content="High" />
              </ComboBox>
            </controls:SettingsCard>
            <controls:SettingsCard Header="Show legend"
                                   Description="CPU and memory series labels on the history chart.">
              <ToggleSwitch x:Name="PerformanceLegendToggle" Toggled="PerformanceLegendToggle_Toggled"
                            AutomationProperties.Name="Show Performance chart legend" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Show CPU series"
                                   Description="Toggle the clay CPU line on the history chart.">
              <ToggleSwitch x:Name="PerformanceCpuToggle" Toggled="PerformanceCpuToggle_Toggled"
                            AutomationProperties.Name="Show Performance CPU series" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Show memory series"
                                   Description="Toggle the sage memory line on the history chart.">
              <ToggleSwitch x:Name="PerformanceMemoryToggle" Toggled="PerformanceMemoryToggle_Toggled"
                            AutomationProperties.Name="Show Performance memory series" />
            </controls:SettingsCard>
          </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <TextBlock Text="HARDWARE CHARTS" Style="{StaticResource EyebrowStyle}" Margin="4,12,0,0" />
        <controls:SettingsExpander Header="Sensor graph tiles"
                                   Description="Shared sampling and display for pinned hardware sensor graphs."
                                   IsExpanded="True">
          <controls:SettingsExpander.Items>
            <controls:SettingsCard Header="Refresh interval"
                                   Description="How often Hardware monitor samples sensors.">
              <ComboBox x:Name="HardwareRefreshBox" MinWidth="160"
                        SelectionChanged="HardwareRefreshBox_SelectionChanged"
                        AutomationProperties.Name="Hardware chart refresh interval">
                <ComboBoxItem Content="1 second" />
                <ComboBoxItem Content="2 seconds" />
                <ComboBoxItem Content="3 seconds" />
                <ComboBoxItem Content="5 seconds" />
              </ComboBox>
            </controls:SettingsCard>
            <controls:SettingsCard Header="History samples"
                                   Description="Keep 30–600 readings per pinned sensor.">
              <NumberBox x:Name="HardwareHistoryBox" MinWidth="120" Minimum="30" Maximum="600"
                         SmallChange="10" SpinButtonPlacementMode="Compact"
                         ValueChanged="HardwareHistoryBox_ValueChanged"
                         AutomationProperties.Name="Hardware chart history samples" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Line smoothing"
                                   Description="Curvature for sensor graph tiles.">
              <ComboBox x:Name="HardwareSmoothingBox" MinWidth="160"
                        SelectionChanged="HardwareSmoothingBox_SelectionChanged"
                        AutomationProperties.Name="Hardware chart line smoothing">
                <ComboBoxItem Content="None" />
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Medium" />
                <ComboBoxItem Content="High" />
              </ComboBox>
            </controls:SettingsCard>
            <controls:SettingsCard Header="Show legend"
                                   Description="Series name under each sensor tile chart.">
              <ToggleSwitch x:Name="HardwareLegendToggle" Toggled="HardwareLegendToggle_Toggled"
                            AutomationProperties.Name="Show Hardware chart legends" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Show axes"
                                   Description="Light X/Y axes on sensor graph tiles.">
              <ToggleSwitch x:Name="HardwareAxesToggle" Toggled="HardwareAxesToggle_Toggled"
                            AutomationProperties.Name="Show Hardware chart axes" />
            </controls:SettingsCard>
          </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <TextBlock Text="SYSTEM CHANGES" Style="{StaticResource EyebrowStyle}" Margin="4,12,0,0" />
        <controls:SettingsCard Header="Restore points"
                               Description="Create a Windows restore point before supported changes.">
          <ToggleSwitch x:Name="RestorePointToggle"
                        Toggled="RestorePointToggle_Toggled"
                        AutomationProperties.Name="Create a Windows restore point before supported changes" />
        </controls:SettingsCard>

        <TextBlock Text="RESET" Style="{StaticResource EyebrowStyle}" Margin="4,12,0,0" />
        <controls:SettingsCard Header="Restore interface defaults"
                               Description="Reset interface and monitoring preferences.">
          <sift:SiftIconButton Icon="Reset" Label="Reset preferences" Click="ResetButton_Click"
                  Style="{StaticResource SecondaryButtonStyle}" />
        </controls:SettingsCard>
      </StackPanel>
    </ScrollViewer>

    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,12,0,0"
               Foreground="{StaticResource SiftMutedBrush}" />
  </Grid>
</UserControl>
