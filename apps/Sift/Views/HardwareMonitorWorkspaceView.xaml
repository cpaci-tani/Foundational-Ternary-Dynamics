<UserControl x:Class="Sift.WinUI.Views.HardwareMonitorWorkspaceView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Sift.WinUI.Controls">
  <UserControl.Resources>
    <Style x:Key="HardwareDeviceContainerStyle" TargetType="ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <DataTemplate x:Key="CoreSensorTileTemplate">
      <Border Background="{StaticResource SiftElevatedBrush}" BorderBrush="{StaticResource SiftLineBrush}"
              BorderThickness="1" CornerRadius="6" Padding="6,5" Margin="0,0,4,4"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Tapped="CoreTile_Tapped">
        <Grid RowSpacing="3">
          <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding CoreLabel}" Style="{StaticResource TypeEyebrowStyle}"
                       VerticalAlignment="Center" FontSize="10"/>
            <controls:SiftIconButton Grid.Column="1" Icon="Pin" Style="{StaticResource SiftPinIconButtonStyle}"
                    Click="GraphButton_Click" Tag="{Binding}"
                    ToolTipService.ToolTip="Pin a live graph for this core"
                    AutomationProperties.Name="{Binding GraphAutomationName}"/>
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding ValueLabel}" Style="{StaticResource InventoryMetricTextStyle}"
                     Foreground="{StaticResource SiftAccentBrush}" FontSize="11" LineHeight="14"
                     TextTrimming="CharacterEllipsis"/>
          <controls:MiniSparkline Grid.Row="2" Values="{Binding SparkValues}" Height="18"
                                  AutomationProperties.AccessibilityView="Raw"/>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="MetricSensorCardTemplate">
      <Border Background="{StaticResource SiftElevatedBrush}" BorderBrush="{StaticResource SiftLineBrush}"
              BorderThickness="1" CornerRadius="8" Padding="8,7" Margin="0,0,6,6"
              MinWidth="148" MaxWidth="210" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Tapped="MetricCard_Tapped">
        <Grid RowSpacing="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" Foreground="{StaticResource SiftTextBrush}" TextTrimming="CharacterEllipsis"
                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <controls:SiftIconButton Grid.Column="1" Icon="Graph" Label="Graph" Style="{StaticResource SecondaryButtonStyle}"
                    Click="GraphButton_Click" Tag="{Binding}"
                    ToolTipService.ToolTip="Pin a live graph for this sensor"
                    AutomationProperties.Name="{Binding GraphAutomationName}"/>
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding ValueLabel}" Style="{StaticResource InventoryMetricTextStyle}"
                     Foreground="{StaticResource SiftAccentBrush}" FontSize="13"/>
          <TextBlock Grid.Row="2" Text="{Binding RangeSummary}" Style="{StaticResource TypeMetaStyle}"
                     FontSize="10" LineHeight="13" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="HardwareSensorSectionTemplate">
      <StackPanel Spacing="8" Margin="0,0,0,10">
        <Grid ColumnSpacing="8" Margin="0,0,2,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Title}" Style="{StaticResource TypeEyebrowStyle}"/>
          <TextBlock Grid.Column="1" Text="{Binding Subtitle}" Style="{StaticResource TypeMetaStyle}"/>
        </Grid>
        <GridView ItemsSource="{Binding CoreSensors}" ItemTemplate="{StaticResource CoreSensorTileTemplate}"
                  SelectionMode="None" IsItemClickEnabled="False"
                  Visibility="{Binding HasCoreSensors}"
                  AutomationProperties.Name="{Binding CoreGridAutomationName}">
          <GridView.ItemsPanel>
            <ItemsPanelTemplate>
              <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" ItemWidth="96" ItemHeight="72"/>
            </ItemsPanelTemplate>
          </GridView.ItemsPanel>
          <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem">
              <Setter Property="Margin" Value="0"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="MinWidth" Value="0"/>
              <Setter Property="MinHeight" Value="0"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
          </GridView.ItemContainerStyle>
        </GridView>
        <GridView ItemsSource="{Binding MetricSensors}" ItemTemplate="{StaticResource MetricSensorCardTemplate}"
                  SelectionMode="None" IsItemClickEnabled="False"
                  Visibility="{Binding HasMetricSensors}"
                  AutomationProperties.Name="{Binding MetricGridAutomationName}">
          <GridView.ItemsPanel>
            <ItemsPanelTemplate>
              <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="168" ItemHeight="78"/>
            </ItemsPanelTemplate>
          </GridView.ItemsPanel>
          <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem">
              <Setter Property="Margin" Value="0"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="MinWidth" Value="0"/>
              <Setter Property="MinHeight" Value="0"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
          </GridView.ItemContainerStyle>
        </GridView>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="HardwareDeviceTemplate">
      <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" AutomationProperties.Name="{Binding AutomationName}"
        Background="{StaticResource SiftCardBrush}" BorderBrush="{StaticResource SiftLineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8"
        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch">
        <Expander.Header>
          <Grid Padding="4,7,10,7" ColumnSpacing="10" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" Style="{StaticResource TypePanelTitleStyle}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="{Binding Type}" Style="{StaticResource TypeEyebrowStyle}" Foreground="{StaticResource SiftAccentBrush}" VerticalAlignment="Center"/>
            <Border Grid.Column="2" Background="{StaticResource SiftAccentDarkBrush}" CornerRadius="7" Padding="8,3"><TextBlock Text="{Binding CountLabel}" Style="{StaticResource TypeMetaStyle}"/></Border>
          </Grid>
        </Expander.Header>
        <ItemsControl Margin="8,0,8,8" ItemsSource="{Binding Sections}"
                      ItemTemplate="{StaticResource HardwareSensorSectionTemplate}"
                      AutomationProperties.Name="{Binding SensorListAutomationName}"/>
      </Expander>
    </DataTemplate>
  </UserControl.Resources>

  <Grid x:Name="RootGrid" RowSpacing="14" SizeChanged="RootGrid_SizeChanged" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="7"><TextBlock Text="Hardware monitor" Style="{StaticResource WorkspaceTitleStyle}"/><TextBlock Text="Live hardware sensors grouped by type, with per-core CPU sparkline grids." Style="{StaticResource WorkspaceSubtitleStyle}" TextWrapping="Wrap"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><ProgressRing x:Name="BusyRing" Width="24" Height="24"/><controls:SiftIconButton x:Name="PauseButton" Icon="Pause" Label="Pause" Click="PauseButton_Click" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Pause hardware sensor sampling"/><controls:SiftIconButton x:Name="RefreshButton" Icon="Refresh" Label="Refresh" Click="RefreshButton_Click" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Refresh hardware sensors"/></StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardBorderStyle}" Padding="14,11"><StackPanel Spacing="3"><TextBlock Text="HOTTEST" Style="{StaticResource TypeEyebrowStyle}"/><TextBlock x:Name="TemperatureText" Text="—" Style="{StaticResource TypeMetricValueStyle}" Foreground="{StaticResource SiftWarningBrush}"/><TextBlock x:Name="TemperatureDetail" Style="{StaticResource TypeMetaStyle}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="14,11"><StackPanel Spacing="3"><TextBlock Text="POWER" Style="{StaticResource TypeEyebrowStyle}"/><TextBlock x:Name="PowerText" Text="—" Style="{StaticResource TypeMetricValueStyle}" Foreground="{StaticResource SiftAccentBrush}"/><TextBlock x:Name="PowerDetail" Style="{StaticResource TypeMetaStyle}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14,11"><StackPanel Spacing="3"><TextBlock Text="FASTEST FAN" Style="{StaticResource TypeEyebrowStyle}"/><TextBlock x:Name="FanText" Text="—" Style="{StaticResource TypeMetricValueStyle}"/><TextBlock x:Name="FanDetail" Style="{StaticResource TypeMetaStyle}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
      <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="14,11"><StackPanel Spacing="3"><TextBlock Text="DISCOVERED" Style="{StaticResource TypeEyebrowStyle}"/><TextBlock x:Name="SensorCountText" Text="0" Style="{StaticResource TypeMetricValueStyle}" Foreground="{StaticResource SiftSuccessBrush}"/><TextBlock x:Name="DeviceCountText" Style="{StaticResource TypeMetaStyle}"/></StackPanel></Border>
    </Grid>

    <Grid x:Name="MonitorSplitGrid" Grid.Row="2" ColumnSpacing="14" RowSpacing="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="InventoryColumn" Width="1.3*"/><ColumnDefinition x:Name="ChartColumn" Width="1*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition x:Name="MonitorTopRow" Height="*"/><RowDefinition x:Name="MonitorBottomRow" Height="0"/></Grid.RowDefinitions>
      <Border Style="{StaticResource CardBorderStyle}" Padding="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
        AutomationProperties.Name="Hardware sensor inventory panel">
        <Grid RowSpacing="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Filter devices and sensors…" TextChanged="Filter_Changed" AutomationProperties.Name="Filter hardware sensors"/>
            <ComboBox x:Name="SensorTypeBox" Grid.Column="1" SelectionChanged="Filter_Changed" AutomationProperties.Name="Filter hardware sensor type"/>
            <controls:SiftIconButton Grid.Column="2" Icon="ExpandAll" Label="Expand all" Click="ExpandAllButton_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="9,6" AutomationProperties.Name="Expand all hardware devices"/>
            <controls:SiftIconButton Grid.Column="3" Icon="CollapseAll" Label="Collapse all" Click="CollapseAllButton_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="9,6" AutomationProperties.Name="Collapse all hardware devices"/>
          </Grid>
          <TextBlock x:Name="ProviderText" Grid.Row="1" Style="{StaticResource TypeMetaStyle}" TextWrapping="Wrap"/>
          <Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch"><ItemsControl x:Name="DeviceGroups" ItemTemplate="{StaticResource HardwareDeviceTemplate}" ItemContainerStyle="{StaticResource HardwareDeviceContainerStyle}" Margin="0,2,4,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></ScrollViewer><StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4"><TextBlock Text="No sensors available" Style="{StaticResource TypeSectionTitleStyle}"/><TextBlock Text="Try another filter. Administrator access may expose additional board sensors." Style="{StaticResource TypeMetaStyle}" TextWrapping="Wrap" MaxWidth="480" TextAlignment="Center"/></StackPanel></Grid>
        </Grid>
      </Border>
      <Border x:Name="ChartPanel" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
        AutomationProperties.Name="Hardware sensor graph dock panel">
        <Grid RowSpacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Spacing="2">
            <TextBlock x:Name="ChartTitle" Text="Sensor graphs" Style="{StaticResource TypePanelTitleStyle}"/>
            <TextBlock x:Name="ChartSubtitle" Text="Pin sensors with Graph. Arrange, tidy, or pop out a floating dock board." Style="{StaticResource TypeMetaStyle}" TextWrapping="Wrap"/>
          </StackPanel>
          <controls:DockHostControl x:Name="GraphDock" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <controls:SiftIconButton Icon="Copy" Label="Copy reading" Click="CopyReadingButton_Click" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Copy selected hardware reading"/>
            <controls:SiftIconButton Icon="Clear" Label="Clear history" Click="ClearHistoryButton_Click" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Clear selected sensor history"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource TypeMetaStyle}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Hardware monitor status"/>
  </Grid>
</UserControl>
