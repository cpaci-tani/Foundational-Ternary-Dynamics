<UserControl
    x:Class="Sift.WinUI.Views.StartupWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls"
    xmlns:tv="using:WinUI.TableView"
    xmlns:conv="using:Sift.WinUI.Infrastructure.Converters">
  <UserControl.Resources>
    <conv:PngToImageSourceConverter x:Key="AppIconConverter" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="7">
        <TextBlock Text="Startup apps" Style="{StaticResource WorkspaceTitleStyle}" />
        <TextBlock Text="Programs configured to run when you sign in."
                   Style="{StaticResource WorkspaceSubtitleStyle}" MaxWidth="900" HorizontalAlignment="Left" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" />
        <controls:SiftIconButton Icon="OpenExternal" Label="Open Windows Startup settings" Click="OpenSettingsButton_Click"
                Style="{StaticResource SecondaryButtonStyle}"
                AutomationProperties.Name="Open Windows Startup settings" />
        <controls:SiftIconButton x:Name="RefreshButton" Icon="Refresh" Label="Refresh" Click="RefreshButton_Click"
                Style="{StaticResource SecondaryButtonStyle}"
                AutomationProperties.Name="Refresh startup inventory" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,22,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" PlaceholderText="Filter by name, command, source, or status…"
               TextChanged="SearchBox_TextChanged" MaxWidth="620" HorizontalAlignment="Stretch"
               AutomationProperties.Name="Filter startup entries" />
      <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="14,9" Margin="12,0,0,0">
        <TextBlock x:Name="CountText" Foreground="{StaticResource SiftMutedBrush}" VerticalAlignment="Center" />
      </Border>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource InventoryPanelStyle}">
      <Grid>
      <tv:TableView x:Name="StartupTable" Style="{StaticResource InventoryTableViewStyle}" SelectionMode="None">
        <tv:TableView.Columns>
          <tv:TableViewTemplateColumn Header="" Width="46">
            <tv:TableViewTemplateColumn.CellTemplate>
              <DataTemplate>
                <Image Source="{Binding IconPng, Converter={StaticResource AppIconConverter}}"
                       Width="24" Height="24" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw" />
              </DataTemplate>
            </tv:TableViewTemplateColumn.CellTemplate>
          </tv:TableViewTemplateColumn>
          <tv:TableViewTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
          <tv:TableViewTextColumn Header="Command" Binding="{Binding Command}" Width="*" />
          <tv:TableViewTextColumn Header="Source" Binding="{Binding Source}" Width="180" />
          <tv:TableViewTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
        </tv:TableView.Columns>
      </tv:TableView>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7" Margin="24">
          <ProgressRing x:Name="StateProgressRing" Width="28" Height="28" IsActive="False" />
          <TextBlock x:Name="StateTitleText" Text="Loading startup entries" FontWeight="SemiBold"
                     Foreground="{StaticResource SiftTextBrush}" HorizontalAlignment="Center" />
          <TextBlock x:Name="StateDetailText" Text="Run keys and Startup folders will appear here."
                     Foreground="{StaticResource SiftMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,12,0,0" Foreground="{StaticResource SiftMutedBrush}" />
  </Grid>
</UserControl>
