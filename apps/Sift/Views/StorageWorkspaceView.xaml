<UserControl
    x:Class="Sift.WinUI.Views.StorageWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls">
  <Grid MinWidth="780" MinHeight="620">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Spacing="7">
      <TextBlock Text="Storage map" Style="{StaticResource WorkspaceTitleStyle}" />
      <TextBlock Text="Scan storage usage and browse folders by size."
                 Style="{StaticResource WorkspaceSubtitleStyle}" MaxWidth="900" HorizontalAlignment="Left" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,22,0,14" Padding="16">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <ComboBox x:Name="RootBox" IsEditable="True" PlaceholderText="Choose or paste a folder path…"
                  AutomationProperties.Name="Storage scan root"
                  ToolTipService.ToolTip="Select a drive or enter an existing folder. Scanning starts when you select Scan storage." />
        <controls:SiftIconButton x:Name="BrowseButton" Grid.Column="1" Icon="OpenFolder" Label="Browse…" Click="BrowseButton_Click"
                Style="{StaticResource SecondaryButtonStyle}"
                AutomationProperties.Name="Choose storage scan folder"
                ToolTipService.ToolTip="Choose one folder with the Windows folder picker." />
        <ProgressRing x:Name="BusyRing" Grid.Column="2" Width="24" Height="24" VerticalAlignment="Center" />
        <controls:SiftIconButton x:Name="CancelButton" Grid.Column="3" Icon="Cancel" Label="Cancel" Click="CancelButton_Click"
                Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                AutomationProperties.Name="Cancel storage operation"
                ToolTipService.ToolTip="Cancel the active scan and discard its partial map." />
        <controls:SiftIconButton x:Name="ScanButton" Grid.Column="4" Icon="Scan" Label="Scan storage" Click="ScanButton_Click"
                AutomationProperties.Name="Scan storage"
                Style="{StaticResource SiftPrimaryIconButtonStyle}"
                ToolTipService.ToolTip="Build a disk map for the selected location. Folder links are not followed." />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnSpacing="12" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardBorderStyle}" Padding="16,12"
              ToolTipService.ToolTip="Total readable file bytes represented by the current scan.">
        <StackPanel Spacing="4">
          <TextBlock Text="MAPPED SIZE" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="SizeText" Text="—" Style="{StaticResource TypeMetricValueStyle}" Foreground="{StaticResource SiftAccentBrush}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16,12"
              ToolTipService.ToolTip="Number of readable files represented by the map.">
        <StackPanel Spacing="4">
          <TextBlock Text="FILES" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="FilesText" Text="—" Style="{StaticResource TypeMetricValueStyle}" Foreground="{StaticResource SiftSuccessBrush}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,12"
              ToolTipService.ToolTip="Total folders and files retained in the in-memory StorageTree.">
        <StackPanel Spacing="4">
          <TextBlock Text="NODES" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="NodesText" Text="—" Style="{StaticResource TypeMetricValueStyle}" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="3" ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="460" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
      <Border Background="{StaticResource SiftCardBrush}" BorderBrush="{StaticResource SiftLineBrush}"
              BorderThickness="1" CornerRadius="10" Padding="10">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid ColumnSpacing="10" Margin="2,0,2,9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <controls:SiftIconButton x:Name="UpButton" Icon="Up" Label="Up" Click="UpButton_Click" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                    AutomationProperties.Name="Show parent storage folder"
                    ToolTipService.ToolTip="Show the parent folder in the treemap." />
            <TextBlock x:Name="CurrentPathText" Grid.Column="1" Text="No map loaded" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource SiftMutedBrush}"
                       ToolTipService.ToolTip="{Binding Text, ElementName=CurrentPathText}" />
            <TextBlock x:Name="MapMetaText" Grid.Column="2" VerticalAlignment="Center" FontSize="10"
                       Foreground="{StaticResource SiftSubtleBrush}"
                       ToolTipService.ToolTip="Shows up to the 1,200 largest visible items." />
          </Grid>
          <controls:StorageTreemapControl x:Name="Treemap" Grid.Row="1" MinWidth="440" MinHeight="420" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Padding="0,0,5,0">
          <Border Style="{StaticResource CardBorderStyle}" Padding="15">
            <StackPanel Spacing="7">
              <TextBlock Text="SELECTED" Style="{StaticResource EyebrowStyle}" />
              <TextBlock x:Name="SelectedNameText" Text="Nothing selected" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
              <TextBlock x:Name="SelectedSizeText" Foreground="{StaticResource SiftAccentBrush}" />
              <TextBlock x:Name="SelectedPathText" Foreground="{StaticResource SiftMutedBrush}" FontSize="11"
                         TextWrapping="Wrap" MaxLines="4"
                         ToolTipService.ToolTip="{Binding Text, ElementName=SelectedPathText}" />
              <controls:SiftIconButton x:Name="DeleteButton" Icon="Clean" Label="Move to Recycle Bin" Click="DeleteButton_Click"
                      Style="{StaticResource SiftDangerIconButtonStyle}" HorizontalAlignment="Stretch" Margin="0,5,0,0"
                      IsEnabled="False" AutomationProperties.Name="Move selected storage item to Recycle Bin"
                      ToolTipService.ToolTip="Check the selected item, then show the Recycle Bin confirmation." />
              <TextBlock Text="Selected item · Recycle Bin" FontSize="10" TextAlignment="Center"
                         Foreground="{StaticResource SiftSubtleBrush}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorderStyle}" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="LARGEST HERE" Style="{StaticResource EyebrowStyle}" Margin="3,3,3,0" />
              <ListView x:Name="LargestList" IsItemClickEnabled="True" ItemClick="LargestList_ItemClick" SelectionMode="None" MaxHeight="285">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid Padding="5,6" ColumnSpacing="8" ToolTipService.ToolTip="{Binding Path}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="{Binding Name}" Foreground="{StaticResource SiftTextBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Type}" FontSize="10" Foreground="{StaticResource SiftMutedBrush}" /></StackPanel>
                      <StackPanel Grid.Column="1"><TextBlock Text="{Binding Size}" HorizontalAlignment="Right" Foreground="{StaticResource SiftAccentBrush}" /><TextBlock Text="{Binding Percent}" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource SiftMutedBrush}" /></StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorderStyle}" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="FILE TYPES" Style="{StaticResource EyebrowStyle}" Margin="3,3,3,0" />
              <ListView x:Name="LegendList" SelectionMode="None" MaxHeight="260">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid Padding="5,5" ColumnSpacing="9" ToolTipService.ToolTip="{Binding Tooltip}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Border Width="11" Height="11" CornerRadius="2" Background="{Binding SwatchBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Extension}" Foreground="{StaticResource SiftTextBrush}" />
                      <TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="{StaticResource SiftMutedBrush}" />
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <TextBlock x:Name="StatusText" Grid.Row="4" Margin="2,12,0,0"
               Foreground="{StaticResource SiftMutedBrush}" TextTrimming="CharacterEllipsis" />
  </Grid>
</UserControl>
