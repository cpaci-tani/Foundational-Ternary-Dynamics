<UserControl
    x:Class="Sift.WinUI.Views.SystemInformationWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls">
  <UserControl.Resources>
    <DataTemplate x:Key="PropertyRowTemplate">
      <Border Style="{StaticResource InventoryRowBorderStyle}" MinHeight="54">
        <Grid ColumnSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.95*" MinWidth="180" />
            <ColumnDefinition Width="1.05*" MinWidth="220" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{Binding Property}" Style="{StaticResource TypeBodyStyle}" TextWrapping="Wrap"
                       LineHeight="20" />
            <TextBlock Text="{Binding Component}" Style="{StaticResource TypeCaptionStyle}" TextWrapping="Wrap"
                       Opacity="0.92" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource TypeBodyStyle}"
                     Foreground="{StaticResource SiftMutedBrush}" TextWrapping="Wrap"
                     LineHeight="22" VerticalAlignment="Center"
                     ToolTipService.ToolTip="{Binding Value}" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,18" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="7">
        <TextBlock Text="System information" Style="{StaticResource WorkspaceTitleStyle}" />
        <TextBlock Text="Hardware, Windows, security, storage, and network details."
                   Style="{StaticResource WorkspaceSubtitleStyle}" MaxWidth="920" HorizontalAlignment="Left" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" />
        <controls:SiftIconButton Icon="OpenExternal" Label="Open msinfo32" Click="OpenMsInfoButton_Click" Style="{StaticResource SecondaryButtonStyle}"
                ToolTipService.ToolTip="Open the built-in Windows System Information application."
                AutomationProperties.Name="Open Windows System Information" />
        <controls:SiftIconButton x:Name="CopyReportButton" Icon="Copy" Label="Copy report" Click="CopyReportButton_Click"
                Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                ToolTipService.ToolTip="Copy the currently visible report. Serial numbers, device IDs, IP addresses, and MAC addresses may be included; review before sharing."
                AutomationProperties.Name="Copy visible system information report" />
        <controls:SiftIconButton x:Name="RefreshButton" Icon="Refresh" Label="Refresh" Click="RefreshButton_Click"
                Style="{StaticResource SecondaryButtonStyle}"
                ToolTipService.ToolTip="Reload Windows system information."
                AutomationProperties.Name="Refresh system information" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource SiftPanelBrush}"
            BorderBrush="{StaticResource SiftLineBrush}" BorderThickness="1"
            CornerRadius="12" Padding="20,18">
      <Grid RowSpacing="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="16" Margin="0,0,0,14">
          <Border Background="{StaticResource SiftCardBrush}" BorderBrush="{StaticResource SiftLineBrush}"
                  BorderThickness="1" CornerRadius="10" Padding="16,14">
            <StackPanel Spacing="6">
              <TextBlock Text="ABOUT THIS PC" Style="{StaticResource TypeEyebrowStyle}" />
              <Grid ColumnSpacing="14" RowSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                  <TextBlock Text="Device" Style="{StaticResource TypeEyebrowStyle}" />
                  <TextBlock x:Name="DeviceNameText" Text="—" Style="{StaticResource TypePanelTitleStyle}" TextWrapping="Wrap" />
                  <TextBlock x:Name="DeviceModelText" Text="Waiting for inventory" Style="{StaticResource TypeMetaStyle}"
                             TextWrapping="Wrap" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="Windows" Style="{StaticResource TypeEyebrowStyle}" />
                  <TextBlock x:Name="WindowsText" Text="—" Style="{StaticResource TypePanelTitleStyle}" TextWrapping="Wrap"
                             ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
                  <TextBlock x:Name="ArchitectureText" Text="Architecture" Style="{StaticResource TypeMetaStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="4">
                  <TextBlock Text="Processor" Style="{StaticResource TypeEyebrowStyle}" />
                  <TextBlock x:Name="ProcessorText" Text="—" Style="{StaticResource TypeBodyStyle}" TextWrapping="Wrap"
                             ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                  <TextBlock Text="Installed memory" Style="{StaticResource TypeEyebrowStyle}" />
                  <TextBlock x:Name="MemoryText" Text="—" Style="{StaticResource TypePanelTitleStyle}"
                             Foreground="{StaticResource SiftAccentBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="230" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Filter by component, property, value, source, or category…"
                     TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Filter system information" />
            <ComboBox x:Name="CategoryFilter" Grid.Column="1" HorizontalAlignment="Stretch"
                      SelectionChanged="CategoryFilter_SelectionChanged"
                      AutomationProperties.Name="Filter system information category"
                      ToolTipService.ToolTip="Show all information or one hardware/system category." />
            <Border Grid.Column="2" Background="{StaticResource SiftElevatedBrush}"
                    BorderBrush="{StaticResource SiftLineBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" MinWidth="120" VerticalAlignment="Stretch">
              <TextBlock x:Name="CountText" Text="0 properties" Style="{StaticResource TypeMetaStyle}"
                         VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
          </Grid>
        </StackPanel>

        <Grid Grid.Row="1" MinHeight="280">
          <Border Background="{StaticResource SiftCardBrush}" BorderBrush="{StaticResource SiftLineBrush}"
                  BorderThickness="1" CornerRadius="10" Padding="0,2,0,6">
            <ScrollViewer x:Name="PropertyScroller" VerticalScrollBarVisibility="Auto"
                          AutomationProperties.Name="System information properties">
              <StackPanel x:Name="SectionsHost" Spacing="0" Padding="0,0,0,4" />
            </ScrollViewer>
          </Border>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Spacing="7" Margin="28" Visibility="Collapsed">
            <ProgressRing x:Name="StateProgressRing" Width="30" Height="30" IsActive="False" />
            <TextBlock x:Name="StateTitleText" Text="Loading system information"
                       Style="{StaticResource TypeSectionTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="StateDetailText" Text="System details will appear here."
                       Style="{StaticResource TypeMetaStyle}" HorizontalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="620" />
          </StackPanel>
        </Grid>

        <Border x:Name="SelectionDetailPanel" Grid.Row="2" Margin="0,14,0,0"
                Background="{StaticResource SiftCardBrush}"
                BorderBrush="{StaticResource SiftLineBrush}" BorderThickness="1"
                CornerRadius="10" Padding="16,14">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
              <TextBlock Text="SELECTED PROPERTY" Style="{StaticResource TypeEyebrowStyle}" />
              <TextBlock x:Name="SelectedPropertyText" Text="Select a row to inspect its full value."
                         Style="{StaticResource TypeSectionTitleStyle}" TextWrapping="Wrap" />
              <TextBlock x:Name="SelectedValueText"
                         Text="Values wrap in the list; this panel shows the complete line for copy."
                         Style="{StaticResource TypeMetaStyle}" TextWrapping="Wrap"
                         ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
            </StackPanel>
            <controls:SiftIconButton x:Name="CopySelectedButton" Grid.Column="1" Icon="Copy" Label="Copy property"
                    Click="CopySelectedButton_Click" Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="False" VerticalAlignment="Center"
                    AutomationProperties.Name="Copy selected system information property" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="2,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Style="{StaticResource TypeMetaStyle}" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="PrivacyText" Grid.Column="1" Text="Review identifiers before sharing"
                 Foreground="{StaticResource SiftWarningBrush}" Style="{StaticResource TypeMetaStyle}"
                 ToolTipService.ToolTip="Copied reports can include serial numbers, device IDs, IP addresses, and MAC addresses." />
    </Grid>
  </Grid>
</UserControl>
