<UserControl
    x:Class="Sift.WinUI.Views.InstalledAppsWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls"
    xmlns:tv="using:WinUI.TableView"
    xmlns:conv="using:Sift.WinUI.Infrastructure.Converters">
  <UserControl.Resources>
    <conv:PngToImageSourceConverter x:Key="AppIconConverter" />
  </UserControl.Resources>
  <Grid MinWidth="560">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="7">
        <TextBlock Text="Installed apps" Style="{StaticResource WorkspaceTitleStyle}" />
        <TextBlock Text="Desktop applications, uninstallers, and leftover entries."
                   Style="{StaticResource WorkspaceSubtitleStyle}" MaxWidth="900" HorizontalAlignment="Left" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" />
        <controls:SiftIconButton Icon="OpenExternal" Label="Open Windows Installed Apps" Click="OpenSettingsButton_Click"
                Style="{StaticResource SecondaryButtonStyle}"
                ToolTipService.ToolTip="Manage Microsoft Store, MSIX, and unsupported entries in Windows Settings."
                AutomationProperties.Name="Open Windows Installed Apps" />
        <controls:SiftIconButton x:Name="RefreshButton" Icon="Refresh" Label="Refresh" Click="RefreshButton_Click"
                Style="{StaticResource SecondaryButtonStyle}"
                ToolTipService.ToolTip="Read the standard current-user, 64-bit, and 32-bit uninstall registry entries again."
                AutomationProperties.Name="Refresh installed apps inventory" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,20,0,12" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardBorderStyle}" Padding="16,12">
        <StackPanel Spacing="4">
          <TextBlock Text="REGISTERED" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="RegisteredText" Style="{StaticResource TypeMetricValueStyle}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16,12">
        <StackPanel Spacing="4">
          <TextBlock Text="UNINSTALLABLE" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="EligibleText" Style="{StaticResource TypeMetricValueStyle}" Foreground="{StaticResource SiftSuccessBrush}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,12"
              ToolTipService.ToolTip="Potential leftovers have a missing registered install directory and a missing non-MSI uninstaller.">
        <StackPanel Spacing="4">
          <TextBlock Text="LEFTOVER REGS" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="LeftoverText" Style="{StaticResource TypeMetricValueStyle}" Foreground="{StaticResource SiftAccentBrush}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="16,12">
        <StackPanel Spacing="4">
          <TextBlock Text="REPORTED SIZE" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="SizeText" Style="{StaticResource TypeMetricValueStyle}" Foreground="{StaticResource SiftAccentBrush}" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,0,0,12" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" PlaceholderText="Filter by app, publisher, version, or source…"
               TextChanged="SearchBox_TextChanged" HorizontalAlignment="Stretch"
               AutomationProperties.Name="Filter installed apps" />
      <ComboBox x:Name="PolicyFilter" Grid.Column="1" SelectionChanged="PolicyFilter_SelectionChanged"
                ToolTipService.ToolTip="Show uninstallable apps, potential leftover registrations, or entries opened in Windows Settings."
                AutomationProperties.Name="Installed app policy filter">
        <ComboBoxItem Content="All apps" />
        <ComboBoxItem Content="Can uninstall" />
        <ComboBoxItem Content="Leftover registrations" />
        <ComboBoxItem Content="Windows Settings only" />
      </ComboBox>
      <controls:SiftIconButton Grid.Column="2" Icon="Search" Label="Find leftover registrations" Click="ReviewLeftoversButton_Click"
              Style="{StaticResource SecondaryButtonStyle}"
              ToolTipService.ToolTip="Show only registrations whose install directory and non-MSI uninstaller are both missing."
              AutomationProperties.Name="Find leftover app registrations" />
      <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="14,9">
        <TextBlock x:Name="CountText" Foreground="{StaticResource SiftMutedBrush}" VerticalAlignment="Center" />
      </Border>
    </Grid>

    <Border Grid.Row="3" Style="{StaticResource InventoryPanelStyle}" MinHeight="190">
      <Grid>
        <tv:TableView x:Name="AppsTable" Style="{StaticResource InventoryTableViewStyle}" SelectionMode="Single"
                      SelectionChanged="AppsTable_SelectionChanged" AutomationProperties.Name="Installed applications">
          <tv:TableView.Columns>
            <tv:TableViewTemplateColumn Header="" Width="46">
              <tv:TableViewTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Image Source="{Binding IconPng, Converter={StaticResource AppIconConverter}}"
                         Width="24" Height="24" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         AutomationProperties.AccessibilityView="Raw" />
                </DataTemplate>
              </tv:TableViewTemplateColumn.CellTemplate>
            </tv:TableViewTemplateColumn>
            <tv:TableViewTextColumn Header="App" Binding="{Binding DisplayName}" Width="260" />
            <tv:TableViewTextColumn Header="Publisher" Binding="{Binding PublisherDisplay}" Width="210" />
            <tv:TableViewTextColumn Header="Version" Binding="{Binding VersionDisplay}" Width="120" />
            <tv:TableViewTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="110" />
            <tv:TableViewTextColumn Header="Installed" Binding="{Binding InstallDateDisplay}" Width="120" />
            <tv:TableViewTextColumn Header="Source" Binding="{Binding Source}" Width="140" />
            <tv:TableViewTextColumn Header="Uninstallable" Binding="{Binding UninstallabilityDisplay}" Width="120" />
            <tv:TableViewTextColumn Header="Policy" Binding="{Binding PolicyDisplay}" Width="*" />
          </tv:TableView.Columns>
        </tv:TableView>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7" Margin="24">
          <ProgressRing x:Name="StateProgressRing" Width="28" Height="28" IsActive="False" />
          <TextBlock x:Name="StateTitleText" Text="Loading installed apps" FontWeight="SemiBold"
                     Foreground="{StaticResource SiftTextBrush}" HorizontalAlignment="Center" />
          <TextBlock x:Name="StateDetailText" Text="Registered desktop software will appear here."
                     Foreground="{StaticResource SiftMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="SelectedAppPanel" Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="16,13" Margin="0,12,0,0">
      <Grid ColumnSpacing="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock Text="SELECTED APP" Style="{StaticResource EyebrowStyle}" />
          <TextBlock x:Name="SelectedNameText" Text="Select an app to inspect its registered details." FontWeight="SemiBold"
                     Foreground="{StaticResource SiftTextBrush}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="SelectedDetailText" Text="Sift never constructs a package name or uninstall command from display text."
                     Foreground="{StaticResource SiftMutedBrush}" TextWrapping="Wrap" />
          <TextBlock x:Name="SelectedPathText" Foreground="{StaticResource SiftSubtleBrush}"
                     FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" />
          <Border x:Name="TrustPanel" Margin="0,6,0,0" Padding="10,8" CornerRadius="7"
                  Background="{StaticResource SiftPanelBrush}" BorderBrush="{StaticResource SiftLineBrush}"
                  BorderThickness="1" Visibility="Collapsed">
            <StackPanel Spacing="3">
              <TextBlock Text="UNINSTALLER TRUST" Style="{StaticResource EyebrowStyle}" />
              <TextBlock x:Name="TrustSummaryText" Foreground="{StaticResource SiftMutedBrush}"
                         FontWeight="SemiBold" AutomationProperties.Name="Selected app uninstaller trust summary" />
              <TextBlock x:Name="TrustDetailText" Foreground="{StaticResource SiftMutedBrush}"
                         FontSize="11" TextWrapping="Wrap" MaxLines="2"
                         AutomationProperties.Name="Selected app uninstaller trust detail" />
              <TextBlock x:Name="TrustMetadataText" Foreground="{StaticResource SiftSubtleBrush}"
                         FontFamily="Consolas" FontSize="10" TextTrimming="CharacterEllipsis"
                         AutomationProperties.Name="Selected app uninstaller trust metadata" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" MinWidth="190">
          <controls:SiftIconButton x:Name="ActionButton" Icon="OpenExternal" Label="Open uninstaller" Click="ActionButton_Click"
                  Style="{StaticResource SiftPrimaryIconButtonStyle}" HorizontalAlignment="Stretch" IsEnabled="False"
                  ToolTipService.ToolTip="Check the selected app, then show the uninstall or registration-removal confirmation."
                  AutomationProperties.Name="Uninstall or clean selected app" />
          <controls:SiftIconButton x:Name="ScanFileLeftoversButton" Icon="Scan" Label="Scan file leftovers" Click="ScanFileLeftoversButton_Click"
                  Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" IsEnabled="False"
                  ToolTipService.ToolTip="After uninstall, look for this app's common AppData folders."
                  AutomationProperties.Name="Scan selected app file leftovers" />
          <TextBlock x:Name="ActionNoteText" Text="One app at a time" FontSize="11" TextAlignment="Center"
                     Foreground="{StaticResource SiftMutedBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="FileLeftoverPanel" Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="16,13"
            Margin="0,12,0,0" Visibility="Collapsed">
      <Grid ColumnSpacing="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
        <Grid RowSpacing="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel Spacing="3">
            <TextBlock Text="APP FILE LEFTOVERS" Style="{StaticResource EyebrowStyle}" />
            <TextBlock x:Name="FileLeftoverTitleText" FontWeight="SemiBold" Foreground="{StaticResource SiftTextBrush}" />
            <TextBlock x:Name="FileLeftoverStatusText" Foreground="{StaticResource SiftMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <ListView x:Name="FileLeftoverList" Grid.Row="1" SelectionMode="None" MaxHeight="150" Margin="0,4,0,0">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="8,7" ColumnSpacing="10" BorderBrush="{StaticResource SiftLineBrush}" BorderThickness="0,0,0,1">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanDelete}"
                            AutomationProperties.Name="Select app leftover folder" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Path}" Foreground="{StaticResource SiftTextBrush}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{Binding Path}" />
                    <TextBlock Text="{Binding Evidence}" Foreground="{StaticResource SiftSubtleBrush}" FontSize="10"
                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Evidence}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Scope}" Foreground="{StaticResource SiftMutedBrush}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SizeDisplay}" Foreground="{StaticResource SiftAccentBrush}" TextAlignment="Right" />
                    <TextBlock Text="{Binding FileDisplay}" Foreground="{StaticResource SiftMutedBrush}" FontSize="10" TextAlignment="Right" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
          <controls:SiftIconButton x:Name="DeleteFileLeftoversButton" Icon="Clean" Label="Move to Recycle Bin" Click="DeleteFileLeftoversButton_Click"
                  Style="{StaticResource SiftPrimaryIconButtonStyle}" HorizontalAlignment="Stretch" IsEnabled="False"
                  ToolTipService.ToolTip="Check the selected folders, then show the Recycle Bin confirmation."
                  AutomationProperties.Name="Delete selected app leftovers" />
          <controls:SiftIconButton Icon="Cancel" Label="Back to app details" Click="CloseFileLeftoversButton_Click"
                  Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Close app file leftovers" />
          <TextBlock x:Name="FileLeftoverSelectionText" Text="Nothing selected by default · Recycle Bin only" FontSize="11" TextAlignment="Center"
                     Foreground="{StaticResource SiftMutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock x:Name="StatusText" Grid.Row="5" Margin="2,10,0,0" Foreground="{StaticResource SiftMutedBrush}" />
  </Grid>
</UserControl>
