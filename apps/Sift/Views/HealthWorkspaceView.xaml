<UserControl
    x:Class="Sift.WinUI.Views.HealthWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls">
  <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="LayoutStates">
        <VisualState x:Name="Wide">
          <VisualState.Setters>
            <Setter Target="ChecksFilterColumn.Width" Value="*" />
            <Setter Target="HistoryFilterColumn.Width" Value="*" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.Setters>
            <Setter Target="ChecksFilterColumn.Width" Value="*" />
            <Setter Target="HistoryFilterColumn.Width" Value="*" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="7">
        <TextBlock Text="Health" Style="{StaticResource WorkspaceTitleStyle}" />
        <TextBlock Text="System checks and activity history."
                   Style="{StaticResource WorkspaceSubtitleStyle}" MaxWidth="900" HorizontalAlignment="Left" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressRing x:Name="BusyRing" Width="24" Height="24" />
        <controls:SiftIconButton x:Name="RefreshButton" Icon="Refresh" Label="Refresh health" Click="RefreshButton_Click"
                AutomationProperties.Name="Refresh health"
                Style="{StaticResource SecondaryButtonStyle}" />
      </StackPanel>
    </Grid>

    <TabView x:Name="HealthTabs" Grid.Row="2" Margin="0,22,0,0" IsAddTabButtonVisible="False"
             SelectionChanged="HealthTabs_SelectionChanged">
      <TabViewItem Header="Checks" IsClosable="False" AutomationProperties.Name="Show health checks">
        <Grid RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Style="{StaticResource CardBorderStyle}" Padding="16">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ChecksFilterColumn" Width="*" /><ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ChecksFilterBox" PlaceholderText="Filter health checks…"
                       TextChanged="ChecksFilterBox_TextChanged"
                       AutomationProperties.Name="Filter health checks" />
              <TextBlock x:Name="ChecksCountText" Grid.Column="1" Foreground="{StaticResource SiftMutedBrush}"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource InventoryPanelStyle}">
            <Grid>
              <ListView x:Name="ChecksList" ItemContainerStyle="{StaticResource InventoryListItemStyle}"
                        AutomationProperties.Name="Health checks">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource InventoryRowBorderStyle}">
                      <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="3*" /><ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Title}" Foreground="{StaticResource SiftTextBrush}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Detail}" Foreground="{StaticResource SiftMutedBrush}" FontSize="11"
                                     TextWrapping="Wrap" MaxLines="2" />
                          <TextBlock Text="{Binding Recommendation}" Foreground="{StaticResource SiftSubtleBrush}" FontSize="10"
                                     TextWrapping="Wrap" MaxLines="2" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="{StaticResource SiftAccentBrush}"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <StackPanel x:Name="ChecksEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                <ProgressRing x:Name="ChecksStateRing" Width="28" Height="28" />
                <TextBlock x:Name="ChecksStateTitle" Text="Loading health" FontWeight="SemiBold"
                           Foreground="{StaticResource SiftTextBrush}" />
                <TextBlock x:Name="ChecksStateDetail" Foreground="{StaticResource SiftMutedBrush}" TextWrapping="Wrap"
                           MaxWidth="420" HorizontalAlignment="Center" TextAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabViewItem>
      <TabViewItem Header="Activity / Recovery History" IsClosable="False"
                   AutomationProperties.Name="Show activity and recovery history">
        <Grid RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Style="{StaticResource CardBorderStyle}" Padding="16">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HistoryFilterColumn" Width="*" /><ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="HistoryFilterBox" PlaceholderText="Filter activity and recovery history…"
                       TextChanged="HistoryFilterBox_TextChanged"
                       AutomationProperties.Name="Filter activity and recovery history" />
              <TextBlock x:Name="HistoryCountText" Grid.Column="1" Foreground="{StaticResource SiftMutedBrush}"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border x:Name="PartialHistoryPanel" Grid.Row="1" Background="{StaticResource SiftPanelBrush}"
                  BorderBrush="{StaticResource SiftLineBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                  Visibility="Collapsed">
            <TextBlock x:Name="PartialHistoryText" Text="Partial history" Foreground="{StaticResource SiftAccentBrush}"
                       TextWrapping="Wrap" />
          </Border>
          <Border Grid.Row="2" Style="{StaticResource InventoryPanelStyle}">
            <Grid>
              <ListView x:Name="HistoryList" ItemContainerStyle="{StaticResource InventoryListItemStyle}"
                        AutomationProperties.Name="Activity and recovery history">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource InventoryRowBorderStyle}">
                      <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="150" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayTime}" Foreground="{StaticResource SiftMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{StaticResource SiftAccentBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Spacing="3">
                          <TextBlock Text="{Binding Title}" Foreground="{StaticResource SiftTextBrush}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Detail}" Foreground="{StaticResource SiftSubtleBrush}" FontSize="10"
                                     TextWrapping="Wrap" MaxLines="2" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <StackPanel x:Name="HistoryEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                <ProgressRing x:Name="HistoryStateRing" Width="28" Height="28" />
                <TextBlock x:Name="HistoryStateTitle" Text="Loading health" FontWeight="SemiBold"
                           Foreground="{StaticResource SiftTextBrush}" />
                <TextBlock x:Name="HistoryStateDetail" Foreground="{StaticResource SiftMutedBrush}" TextWrapping="Wrap"
                           MaxWidth="420" HorizontalAlignment="Center" TextAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabViewItem>
    </TabView>

    <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,0" Foreground="{StaticResource SiftMutedBrush}" />
  </Grid>
</UserControl>
