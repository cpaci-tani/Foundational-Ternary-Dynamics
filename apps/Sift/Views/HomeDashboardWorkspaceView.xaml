<UserControl
    x:Class="Sift.WinUI.Views.HomeDashboardWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls">
  <Grid RowSpacing="14" SizeChanged="Root_SizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="6">
        <TextBlock Text="Home" Style="{StaticResource WorkspaceTitleStyle}" />
        <TextBlock Text="Live performance, health, history, and Windows tools in one dashboard."
                   Style="{StaticResource WorkspaceSubtitleStyle}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" />
        <controls:SiftIconButton x:Name="RefreshButton" Icon="Refresh" Label="Refresh" Click="RefreshButton_Click"
                Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Refresh dashboard" />
        <controls:SiftIconButton x:Name="CustomizeButton" Icon="Customize" Label="Customize" Click="CustomizeButton_Click"
                Style="{StaticResource SiftPrimaryIconButtonStyle}" AutomationProperties.Name="Customize dashboard" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="10">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="PROFILE" Style="{StaticResource TypeEyebrowStyle}" VerticalAlignment="Center" />
        <ComboBox x:Name="ProfileBox" Grid.Column="1" HorizontalAlignment="Stretch"
                  SelectionChanged="ProfileBox_SelectionChanged" AutomationProperties.Name="Dashboard profile" />
        <controls:SiftIconButton x:Name="ProfileMenuButton" Grid.Column="2" Icon="More" Width="38" Height="34"
                Style="{StaticResource SiftChromeIconButtonStyle}"
                Click="ProfileMenuButton_Click" AutomationProperties.Name="Manage dashboard profiles" />
        <TextBlock x:Name="LayoutSummaryText" Grid.Column="3" Style="{StaticResource TypeMetaStyle}"
                   VerticalAlignment="Center" HorizontalAlignment="Right" />
        <controls:SiftIconButton x:Name="AddWidgetNormalButton" Grid.Column="4" Icon="Add" Label="Add widget" Click="AddWidgetButton_Click"
                Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Add dashboard widget" />
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <ScrollViewer x:Name="DashboardScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <controls:DashboardGridPanel x:Name="DashboardGrid" HorizontalAlignment="Stretch" />
          <Border x:Name="SnapGhost"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  CornerRadius="12"
                  BorderThickness="2"
                  BorderBrush="{StaticResource SiftSuccessBrush}"
                  Background="#33A9BB98"
                  AutomationProperties.AccessibilityView="Raw" />
          <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Margin="24,90" Spacing="8">
            <TextBlock Text="No widgets in this layout" Style="{StaticResource TypeSectionTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Add a widget or restore a profile preset." Style="{StaticResource TypeMetaStyle}" />
            <controls:SiftIconButton Icon="Add" Label="Add widget" Click="AddWidgetButton_Click" Style="{StaticResource SiftPrimaryIconButtonStyle}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Border x:Name="CustomizeBar" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center"
              Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,10,0,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <controls:SiftIconButton Icon="Add" Label="Add widget" Click="AddWidgetButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
          <ComboBox x:Name="BreakpointBox" Width="120" SelectionChanged="BreakpointBox_SelectionChanged"
                    AutomationProperties.Name="Preview dashboard layout" />
          <controls:SiftIconButton Icon="Tidy" Label="Tidy" Click="TidyButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
          <controls:SiftIconButton x:Name="UndoButton" Icon="Undo" Label="Undo" Click="UndoButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
          <controls:SiftIconButton x:Name="RedoButton" Icon="Redo" Label="Redo" Click="RedoButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
          <controls:SiftIconButton Icon="Cancel" Label="Cancel" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
          <controls:SiftIconButton Icon="Save" Label="Save" Click="SaveButton_Click" Style="{StaticResource SiftPrimaryIconButtonStyle}" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Style="{StaticResource TypeMetaStyle}" />
      <TextBlock x:Name="MonitorText" Grid.Column="1" Style="{StaticResource TypeMetaStyle}" />
    </Grid>
  </Grid>
</UserControl>
