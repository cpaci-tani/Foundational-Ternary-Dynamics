<UserControl
    x:Class="Sift.WinUI.Views.TaskManagerWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls"
    xmlns:tv="using:WinUI.TableView"
    xmlns:conv="using:Sift.WinUI.Infrastructure.Converters">
  <UserControl.Resources>
    <conv:PngToImageSourceConverter x:Key="AppIconConverter" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="7">
        <TextBlock Text="Task Manager" Style="{StaticResource WorkspaceTitleStyle}" />
        <TextBlock Text="Processes, services, and scheduled tasks."
                   Style="{StaticResource WorkspaceSubtitleStyle}" MaxWidth="900" HorizontalAlignment="Left" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressRing x:Name="BusyRing" Width="24" Height="24" />
        <controls:SiftIconButton x:Name="RefreshButton" Icon="Refresh" Label="Refresh" Click="RefreshButton_Click"
                Style="{StaticResource SecondaryButtonStyle}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,22,0,14" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardBorderStyle}" Padding="16,13">
        <StackPanel Spacing="4">
          <TextBlock Text="CPU" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="CpuText" Style="{StaticResource TypeMetricValueStyle}" Foreground="{StaticResource SiftAccentBrush}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16,13">
        <StackPanel Spacing="4">
          <TextBlock Text="MEMORY" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="MemoryText" Style="{StaticResource TypeMetricValueStyle}" Foreground="{StaticResource SiftSuccessBrush}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,13">
        <StackPanel Spacing="4">
          <TextBlock Text="SERVICES" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="ServiceText" Style="{StaticResource TypeMetricValueStyle}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="16,13">
        <StackPanel Spacing="4">
          <TextBlock Text="TASKS" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="TaskText" Style="{StaticResource TypeMetricValueStyle}" />
        </StackPanel>
      </Border>
    </Grid>

    <TextBox x:Name="SearchBox" Grid.Row="2" PlaceholderText="Filter the active inventory…"
             TextChanged="SearchBox_TextChanged" MaxWidth="620" HorizontalAlignment="Left"
             AutomationProperties.Name="Filter Task Manager inventory" />

    <TabView x:Name="InventoryTabs" Grid.Row="3" Margin="0,12,0,0" IsAddTabButtonVisible="False"
             SelectionChanged="InventoryTabs_SelectionChanged">
      <TabViewItem Header="Processes" IsClosable="False" AutomationProperties.Name="Show process inventory">
        <Grid RowSpacing="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Style="{StaticResource CardBorderStyle}" Padding="12,9">
            <Grid ColumnSpacing="9">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock x:Name="SelectedProcessText" Text="Select a process"
                         VerticalAlignment="Center" Foreground="{StaticResource SiftMutedBrush}" TextTrimming="CharacterEllipsis" />
              <controls:SiftIconButton x:Name="RestartProcessButton" Grid.Column="1" Icon="Restart" Label="Restart app" IsEnabled="False"
                      Click="RestartProcessButton_Click" Style="{StaticResource SecondaryButtonStyle}"
                      AutomationProperties.Name="Restart selected process"
                      ToolTipService.ToolTip="End and reopen the selected app." />
              <controls:SiftIconButton x:Name="EndProcessButton" Grid.Column="2" Icon="EndTask" Label="End task" IsEnabled="False"
                      Click="EndProcessButton_Click" Style="{StaticResource SiftDangerIconButtonStyle}"
                      AutomationProperties.Name="End selected task"
                      ToolTipService.ToolTip="End the selected process. Unsaved work may be lost." />
            </Grid>
          </Border>
          <Expander Grid.Row="1" Header="Process inventory" IsExpanded="True"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="Collapse or expand process inventory">
            <Border Style="{StaticResource InventoryPanelStyle}" MinHeight="330">
              <tv:TableView x:Name="ProcessTable" Style="{StaticResource InventoryTableViewStyle}" SelectionMode="Single"
                            SelectionChanged="InventorySelection_Changed" AutomationProperties.Name="Running processes">
                <tv:TableView.Columns>
                  <tv:TableViewTemplateColumn Header="" Width="46">
                    <tv:TableViewTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Image Source="{Binding IconPng, Converter={StaticResource AppIconConverter}}"
                               Width="24" Height="24" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               AutomationProperties.AccessibilityView="Raw" />
                      </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                  </tv:TableViewTemplateColumn>
                  <tv:TableViewTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                  <tv:TableViewTextColumn Header="PID" Binding="{Binding Id}" Width="90" />
                  <tv:TableViewTextColumn Header="CPU" Binding="{Binding CpuLabel}" Width="90" />
                  <tv:TableViewTextColumn Header="Memory" Binding="{Binding MemoryLabel}" Width="120" />
                  <tv:TableViewTextColumn Header="Threads" Binding="{Binding ThreadCount}" Width="100" />
                  <tv:TableViewTextColumn Header="Architecture" Binding="{Binding Architecture}" Width="120" />
                  <tv:TableViewTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                </tv:TableView.Columns>
              </tv:TableView>
            </Border>
          </Expander>
        </Grid>
      </TabViewItem>
      <TabViewItem Header="Services" IsClosable="False" AutomationProperties.Name="Show services inventory">
        <Grid RowSpacing="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Style="{StaticResource CardBorderStyle}" Padding="12,9">
            <Grid ColumnSpacing="9">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock x:Name="SelectedServiceText" Text="Select one manageable third-party service"
                         VerticalAlignment="Center" Foreground="{StaticResource SiftMutedBrush}" TextTrimming="CharacterEllipsis" />
              <controls:SiftIconButton x:Name="StartServiceButton" Grid.Column="1" Icon="Start" Label="Start service" IsEnabled="False"
                      Click="StartServiceButton_Click" Style="{StaticResource SiftPrimaryIconButtonStyle}"
                      AutomationProperties.Name="Start selected service"
                      ToolTipService.ToolTip="Confirm and start one selected third-party service. Windows and system services are view only." />
              <controls:SiftIconButton x:Name="RestartServiceButton" Grid.Column="2" Icon="Restart" Label="Restart service" IsEnabled="False"
                      Click="RestartServiceButton_Click" Style="{StaticResource SecondaryButtonStyle}"
                      AutomationProperties.Name="Restart selected service"
                      ToolTipService.ToolTip="Confirm and restart one selected third-party service. Windows will ask for administrator permission when required." />
            </Grid>
          </Border>
          <Expander Grid.Row="1" Header="Service inventory" IsExpanded="True"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="Collapse or expand service inventory">
            <Border Style="{StaticResource InventoryPanelStyle}" MinHeight="330">
              <tv:TableView x:Name="ServiceTable" Style="{StaticResource InventoryTableViewStyle}" SelectionMode="Single"
                            SelectionChanged="InventorySelection_Changed" AutomationProperties.Name="Windows services">
                <tv:TableView.Columns>
                  <tv:TableViewTemplateColumn Header="" Width="46">
                    <tv:TableViewTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Image Source="{Binding IconPng, Converter={StaticResource AppIconConverter}}"
                               Width="24" Height="24" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               AutomationProperties.AccessibilityView="Raw" />
                      </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                  </tv:TableViewTemplateColumn>
                  <tv:TableViewTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="245" />
                  <tv:TableViewTextColumn Header="Service" Binding="{Binding Name}" Width="155" />
                  <tv:TableViewTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                  <tv:TableViewTextColumn Header="Start type" Binding="{Binding StartType}" Width="120" />
                  <tv:TableViewTextColumn Header="Policy" Binding="{Binding GroupKey}" Width="*" />
                </tv:TableView.Columns>
              </tv:TableView>
            </Border>
          </Expander>
        </Grid>
      </TabViewItem>
      <TabViewItem Header="Scheduled tasks" IsClosable="False" AutomationProperties.Name="Show scheduled task inventory">
        <Grid RowSpacing="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Style="{StaticResource CardBorderStyle}" Padding="12,9">
            <Grid ColumnSpacing="9">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock x:Name="SelectedTaskText" Text="Select a scheduled task"
                         VerticalAlignment="Center" Foreground="{StaticResource SiftMutedBrush}" TextWrapping="Wrap" />
              <controls:SiftIconButton x:Name="EnableTaskButton" Grid.Column="1" Icon="Enable" Label="Enable task" IsEnabled="False"
                      Click="EnableTaskButton_Click" Style="{StaticResource SiftPrimaryIconButtonStyle}"
                      AutomationProperties.Name="Enable selected scheduled task"
                      ToolTipService.ToolTip="Enable the selected supported scheduled task." />
              <controls:SiftIconButton x:Name="DisableTaskButton" Grid.Column="2" Icon="Disable" Label="Disable task" IsEnabled="False"
                      Click="DisableTaskButton_Click" Style="{StaticResource SecondaryButtonStyle}"
                      AutomationProperties.Name="Disable selected scheduled task"
                      ToolTipService.ToolTip="Disable the selected supported scheduled task." />
            </Grid>
          </Border>
          <Expander Grid.Row="1" Header="Scheduled-task inventory" IsExpanded="True"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="Collapse or expand scheduled task inventory">
            <Border Style="{StaticResource InventoryPanelStyle}" MinHeight="360">
              <tv:TableView x:Name="TaskTable" Style="{StaticResource InventoryTableViewStyle}" SelectionMode="Single"
                            SelectionChanged="InventorySelection_Changed" AutomationProperties.Name="Scheduled tasks">
                <tv:TableView.Columns>
                  <tv:TableViewTemplateColumn Header="" Width="46">
                    <tv:TableViewTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Image Source="{Binding IconPng, Converter={StaticResource AppIconConverter}}"
                               Width="24" Height="24" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               AutomationProperties.AccessibilityView="Raw" />
                      </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                  </tv:TableViewTemplateColumn>
                  <tv:TableViewTextColumn Header="Task" Binding="{Binding TaskName}" Width="225" />
                  <tv:TableViewTextColumn Header="Path" Binding="{Binding TaskPath}" Width="*" />
                  <tv:TableViewTextColumn Header="State" Binding="{Binding State}" Width="120" />
                  <tv:TableViewTextColumn Header="Author" Binding="{Binding Author}" Width="165" />
                  <tv:TableViewTextColumn Header="Policy" Binding="{Binding GroupKey}" Width="140" />
                </tv:TableView.Columns>
              </tv:TableView>
            </Border>
          </Expander>
        </Grid>
      </TabViewItem>
    </TabView>

    <TextBlock x:Name="StatusText" Grid.Row="4" Margin="2,12,0,0" Foreground="{StaticResource SiftMutedBrush}" />
  </Grid>
</UserControl>
