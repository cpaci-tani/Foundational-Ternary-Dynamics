<UserControl
    x:Class="Sift.WinUI.Views.PerformanceWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:conv="using:Sift.WinUI.Infrastructure.Converters">
  <UserControl.Resources>
    <conv:PngToImageSourceConverter x:Key="AppIconConverter" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="7">
        <TextBlock Text="Performance" Style="{StaticResource WorkspaceTitleStyle}" />
        <TextBlock Text="Live CPU, memory, disk, and process usage."
                   Style="{StaticResource WorkspaceSubtitleStyle}" MaxWidth="900" HorizontalAlignment="Left" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" />
        <controls:SiftIconButton x:Name="PauseButton" Icon="Pause" Label="Pause" Click="PauseButton_Click"
                Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Pause performance sampling" />
        <controls:SiftIconButton x:Name="RefreshButton" Icon="Refresh" Label="Refresh" Click="RefreshButton_Click"
                Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Refresh performance sample" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,22,0,16" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardBorderStyle}" Padding="16,13">
        <StackPanel Spacing="3">
          <TextBlock Text="CPU" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="CpuText" Style="{StaticResource TypeMetricValueStyle}" Foreground="{StaticResource SiftAccentBrush}" />
          <TextBlock x:Name="CpuDetail" Style="{StaticResource TypeMetaStyle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16,13">
        <StackPanel Spacing="3">
          <TextBlock Text="MEMORY" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="MemoryText" Style="{StaticResource TypeMetricValueStyle}" Foreground="{StaticResource SiftSuccessBrush}" />
          <TextBlock x:Name="MemoryDetail" Style="{StaticResource TypeMetaStyle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,13">
        <StackPanel Spacing="3">
          <TextBlock Text="PROCESSES" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="ProcessText" Style="{StaticResource TypeMetricValueStyle}" />
          <TextBlock x:Name="ProcessDetail" Style="{StaticResource TypeMetaStyle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="16,13">
        <StackPanel Spacing="3">
          <TextBlock Text="DISK I/O" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="DiskText" Style="{StaticResource TypeMetricValueStyle}" />
          <TextBlock x:Name="DiskDetail" Style="{StaticResource TypeMetaStyle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </Grid>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid RowSpacing="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="360" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CardBorderStyle}" Padding="18,15">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Spacing="3">
                <TextBlock Text="System pressure history" Style="{StaticResource TypePanelTitleStyle}" />
                <TextBlock x:Name="HistorySubtitle" Text="CPU and memory percentage"
                           Style="{StaticResource TypeMetaStyle}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <CheckBox x:Name="ShowCpuCheck" Content="CPU"
                          Checked="ChartToggle_Changed" Unchecked="ChartToggle_Changed"
                          AutomationProperties.Name="Show CPU series" />
                <CheckBox x:Name="ShowMemoryCheck" Content="Memory"
                          Checked="ChartToggle_Changed" Unchecked="ChartToggle_Changed"
                          AutomationProperties.Name="Show memory series" />
                <CheckBox x:Name="ShowLegendCheck" Content="Legend"
                          Checked="ChartToggle_Changed" Unchecked="ChartToggle_Changed"
                          AutomationProperties.Name="Show chart legend" />
              </StackPanel>
            </Grid>
            <lvc:CartesianChart x:Name="HistoryChart" Grid.Row="1" Margin="0,12,0,0"
                                Background="{StaticResource SiftBackgroundBrush}" />
          </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardBorderStyle}" Padding="18,15">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="Top CPU consumers" Style="{StaticResource TypePanelTitleStyle}" />
              <ListView x:Name="TopCpuList" Grid.Row="1" Margin="0,10,0,0" SelectionMode="None" MaxHeight="330"
                        ItemContainerStyle="{StaticResource InventoryListItemStyle}">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource InventoryRowBorderStyle}" Padding="8,10">
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Image Source="{Binding IconPng, Converter={StaticResource AppIconConverter}}"
                               Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                               AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Foreground="{StaticResource SiftTextBrush}" /><TextBlock Text="{Binding Context}" FontSize="10" Foreground="{StaticResource SiftMutedBrush}" /></StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource InventoryMetricTextStyle}"
                                   Foreground="{StaticResource SiftAccentBrush}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="18,15">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="Top memory consumers" Style="{StaticResource TypePanelTitleStyle}" />
              <ListView x:Name="TopMemoryList" Grid.Row="1" Margin="0,10,0,0" SelectionMode="None" MaxHeight="330"
                        ItemContainerStyle="{StaticResource InventoryListItemStyle}">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource InventoryRowBorderStyle}" Padding="8,10">
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Image Source="{Binding IconPng, Converter={StaticResource AppIconConverter}}"
                               Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                               AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Foreground="{StaticResource SiftTextBrush}" /><TextBlock Text="{Binding Context}" FontSize="10" Foreground="{StaticResource SiftMutedBrush}" /></StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource InventoryMetricTextStyle}"
                                   Foreground="{StaticResource SiftSuccessBrush}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>

    <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,12,0,0" Foreground="{StaticResource SiftMutedBrush}" />
  </Grid>
</UserControl>
