<UserControl
    x:Class="Sift.WinUI.Views.MaintenanceWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="7">
        <TextBlock Text="Maintenance" Style="{StaticResource WorkspaceTitleStyle}" />
        <TextBlock Text="Scan and clean temporary files and unused registrations."
                   Style="{StaticResource WorkspaceSubtitleStyle}" MaxWidth="900" HorizontalAlignment="Left" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
        <ProgressRing x:Name="BusyRing" Width="24" Height="24" />
        <controls:SiftIconButton x:Name="ScanButton" Icon="Scan" Label="Scan again" Click="ScanButton_Click"
                Style="{StaticResource SecondaryButtonStyle}" />
        <controls:SiftIconButton x:Name="CleanButton" Icon="Clean" Label="Clean selected" Click="CleanButton_Click"
                AutomationProperties.Name="Clean selected maintenance items"
                Style="{StaticResource SiftPrimaryIconButtonStyle}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,22,0,14" Padding="16">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" PlaceholderText="Filter items…" TextChanged="SearchBox_TextChanged"
                 AutomationProperties.Name="Filter maintenance items" />
        <ComboBox x:Name="CategoryBox" Grid.Column="1" SelectionChanged="CategoryBox_SelectionChanged"
                  AutomationProperties.Name="Maintenance category" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,0,0,12" ColumnSpacing="9">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <controls:SiftIconButton Icon="Select" Label="Select recommended" Click="SelectRecommendedButton_Click"
              AutomationProperties.Name="Select recommended maintenance items"
              Style="{StaticResource SecondaryButtonStyle}" />
      <controls:SiftIconButton Grid.Column="1" Icon="Clear" Label="Clear selection" Click="ClearButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
      <TextBlock x:Name="SizeText" Grid.Column="3" Foreground="{StaticResource SiftAccentBrush}" VerticalAlignment="Center" />
    </Grid>

    <Border Grid.Row="3" Style="{StaticResource InventoryPanelStyle}">
      <Grid>
        <ListView x:Name="FindingList" SelectionMode="None" ItemContainerStyle="{StaticResource InventoryListItemStyle}">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource InventoryRowBorderStyle}">
                <Grid ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="150" />
                    <ColumnDefinition Width="110" /><ColumnDefinition Width="100" />
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanClean}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource SiftTextBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Path}" Style="{StaticResource InventoryPathTextStyle}"
                               Foreground="{StaticResource SiftMutedBrush}" />
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource SiftSubtleBrush}" FontSize="10"
                               TextWrapping="Wrap" MaxLines="2" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding CategoryLabel}" Foreground="{StaticResource SiftMutedBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding ConfidenceLabel}" Foreground="{StaticResource SiftSuccessBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding SizeLabel}" Style="{StaticResource InventoryMetricTextStyle}"
                             Foreground="{StaticResource SiftAccentBrush}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
          <ProgressRing x:Name="StateRing" Width="28" Height="28" />
          <TextBlock x:Name="StateTitle" Text="Ready to scan" FontWeight="SemiBold" Foreground="{StaticResource SiftTextBrush}" />
          <TextBlock x:Name="StateDetail" Text="Temporary files, caches, and unused app registrations appear here."
                     Foreground="{StaticResource SiftMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock x:Name="StatusText" Grid.Row="4" Margin="2,12,0,0"
               Foreground="{StaticResource SiftMutedBrush}" TextWrapping="Wrap" />
  </Grid>
</UserControl>
