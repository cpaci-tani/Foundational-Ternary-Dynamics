<UserControl
    x:Class="Sift.WinUI.Views.RecoveryWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls"
    xmlns:tv="using:WinUI.TableView">
  <Grid MinWidth="560">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="7">
        <TextBlock Text="Recovery" Style="{StaticResource WorkspaceTitleStyle}" />
        <TextBlock Text="Inspect and restore Sift backups."
                   Style="{StaticResource WorkspaceSubtitleStyle}" MaxWidth="900" HorizontalAlignment="Left" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" />
        <controls:SiftIconButton Icon="OpenFolder" Label="Open backup folder" Click="OpenFolderButton_Click" Style="{StaticResource SecondaryButtonStyle}"
                ToolTipService.ToolTip="Open the Sift backup folder in File Explorer."
                AutomationProperties.Name="Open Sift backup folder" />
        <controls:SiftIconButton x:Name="RefreshButton" Icon="Refresh" Label="Refresh" Click="RefreshButton_Click" Style="{StaticResource SecondaryButtonStyle}"
                ToolTipService.ToolTip="Reload Sift backup files."
                AutomationProperties.Name="Refresh recovery backups" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,20,0,12" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardBorderStyle}" Padding="16,12">
        <StackPanel Spacing="4">
          <TextBlock Text="BACKUPS" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="BackupCountText" Style="{StaticResource TypeMetricValueStyle}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16,12">
        <StackPanel Spacing="4">
          <TextBlock Text="READY" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="ReadyCountText" Style="{StaticResource TypeMetricValueStyle}" Foreground="{StaticResource SiftSuccessBrush}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,12"
              ToolTipService.ToolTip="Backups containing changes that require administrator permission.">
        <StackPanel Spacing="4">
          <TextBlock Text="ADMIN REQUIRED" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="ProtectedCountText" Style="{StaticResource TypeMetricValueStyle}" Foreground="{StaticResource SiftAccentBrush}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="16,12">
        <StackPanel Spacing="4">
          <TextBlock Text="PENDING ENTRIES" Style="{StaticResource TypeEyebrowStyle}" />
          <TextBlock x:Name="PendingCountText" Style="{StaticResource TypeMetricValueStyle}" Foreground="{StaticResource SiftWarningBrush}" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,0,0,12" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" PlaceholderText="Filter by date, source, status, scope, machine, or file…"
               TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Filter recovery backups" />
      <ComboBox x:Name="StatusFilter" Grid.Column="1" SelectionChanged="StatusFilter_SelectionChanged"
                ToolTipService.ToolTip="Limit the table to ready, completed, or blocked backups."
                AutomationProperties.Name="Recovery status filter">
        <ComboBoxItem Content="All backups" />
        <ComboBoxItem Content="Ready" />
        <ComboBoxItem Content="Complete" />
        <ComboBoxItem Content="Blocked" />
      </ComboBox>
      <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14,9">
        <TextBlock x:Name="VisibleCountText" Foreground="{StaticResource SiftMutedBrush}" VerticalAlignment="Center" />
      </Border>
    </Grid>

    <Border Grid.Row="3" Style="{StaticResource InventoryPanelStyle}" MinHeight="210">
      <Grid>
        <tv:TableView x:Name="BackupsTable" Style="{StaticResource InventoryTableViewStyle}" SelectionMode="Single"
                      SelectionChanged="BackupsTable_SelectionChanged" AutomationProperties.Name="Sift recovery backups">
          <tv:TableView.Columns>
            <tv:TableViewTextColumn Header="Created" Binding="{Binding CreatedDisplay}" Width="155" />
            <tv:TableViewTextColumn Header="Source" Binding="{Binding Source}" Width="155" />
            <tv:TableViewTextColumn Header="Entries" Binding="{Binding EntryDisplay}" Width="170" />
            <tv:TableViewTextColumn Header="Scope" Binding="{Binding ScopeDisplay}" Width="190" />
            <tv:TableViewTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
            <tv:TableViewTextColumn Header="Restorable" Binding="{Binding RestoreDisplay}" Width="105" />
            <tv:TableViewTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
          </tv:TableView.Columns>
        </tv:TableView>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7" Margin="24">
          <ProgressRing x:Name="StateProgressRing" Width="28" Height="28" IsActive="False" />
          <TextBlock x:Name="StateTitleText" Text="Loading recovery backups" FontWeight="SemiBold"
                     Foreground="{StaticResource SiftTextBrush}" HorizontalAlignment="Center" />
          <TextBlock x:Name="StateDetailText" Text="Sift backup records will appear here."
                     Foreground="{StaticResource SiftMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="16,13" Margin="0,12,0,0">
      <Grid ColumnSpacing="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock Text="SELECTED BACKUP" Style="{StaticResource EyebrowStyle}" />
          <TextBlock x:Name="SelectedTitleText" Text="Select a backup to see its contents."
                     FontWeight="SemiBold" Foreground="{StaticResource SiftTextBrush}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="SelectedDetailText" Text="Nothing changes until you select Restore backup and confirm."
                     Foreground="{StaticResource SiftMutedBrush}" TextWrapping="Wrap" />
          <TextBlock x:Name="SelectedPathText" Foreground="{StaticResource SiftSubtleBrush}"
                     FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
          <controls:SiftIconButton x:Name="RestoreButton" Icon="Restore" Label="Restore backup" Click="RestoreButton_Click"
                  Style="{StaticResource SiftPrimaryIconButtonStyle}" HorizontalAlignment="Stretch" IsEnabled="False"
                  ToolTipService.ToolTip="Check the selected backup and show the restore confirmation."
                  AutomationProperties.Name="Restore selected recovery backup" />
          <TextBlock x:Name="SelectionNoteText" Text="Select a ready backup" FontSize="11" TextAlignment="Center"
                     Foreground="{StaticResource SiftMutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock x:Name="StatusText" Grid.Row="5" Margin="2,10,0,0" Foreground="{StaticResource SiftMutedBrush}" />
  </Grid>
</UserControl>
