<Window
    x:Class="Sift.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls">
  <Grid x:Name="RootGrid" Background="{StaticResource SiftBackgroundBrush}" Loaded="RootGrid_Loaded" SizeChanged="RootGrid_SizeChanged">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="WorkspaceAccelerator_Invoked" />
      <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="WorkspaceAccelerator_Invoked" />
      <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="WorkspaceAccelerator_Invoked" />
      <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="WorkspaceAccelerator_Invoked" />
      <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="WorkspaceAccelerator_Invoked" />
      <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="WorkspaceAccelerator_Invoked" />
      <KeyboardAccelerator Key="Number7" Modifiers="Control" Invoked="WorkspaceAccelerator_Invoked" />
      <KeyboardAccelerator Key="Number8" Modifiers="Control" Invoked="WorkspaceAccelerator_Invoked" />
      <KeyboardAccelerator Key="Number9" Modifiers="Control" Invoked="WorkspaceAccelerator_Invoked" />
      <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="WorkspaceAccelerator_Invoked" />
      <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="SystemInformationAccelerator_Invoked" />
      <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBarDragRegion" Background="{StaticResource SiftPanelBrush}"
          BorderBrush="{StaticResource SiftLineBrush}" BorderThickness="0,0,0,1"
          Padding="18,0,150,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/SiftLogo.png" Width="26" Height="26" />
        <TextBlock Text="Sift" Style="{StaticResource TypeShellBrandStyle}" VerticalAlignment="Center" />
      </StackPanel>
      <controls:SiftIconButton x:Name="ConsoleToggleButton" Grid.Column="1" Icon="ActivityLog" Label="Activity log"
              Click="ConsoleToggleButton_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"
              AutomationProperties.Name="Toggle activity console" />
    </Grid>

    <Grid x:Name="ShellContentGrid" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="ConsoleColumn" Width="380" />
      </Grid.ColumnDefinitions>

      <NavigationView x:Name="ShellNavigation" Grid.Column="0" PaneDisplayMode="Left" IsSettingsVisible="True"
                      IsBackButtonVisible="Collapsed" OpenPaneLength="252" CompactPaneLength="56"
                      SelectionChanged="ShellNavigation_SelectionChanged" Background="{StaticResource SiftBackgroundBrush}">
        <NavigationView.PaneHeader>
          <TextBlock Text="Windows tools" Style="{StaticResource TypeEyebrowStyle}" Margin="5,16,0,12" />
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
          <NavigationViewItem Content="Home" Tag="Home" />
          <NavigationViewItem Content="Optimize" Tag="Optimize" />
          <NavigationViewItem Content="Task Manager" Tag="TaskManager" />
          <NavigationViewItem Content="Performance" Tag="Performance" />
          <NavigationViewItem Content="Hardware monitor" Tag="HardwareMonitor" />
          <NavigationViewItem Content="Startup" Tag="Startup" />
          <NavigationViewItem Content="Maintenance" Tag="Maintenance" />
          <NavigationViewItem Content="Script studio" Tag="Scripts" />
          <NavigationViewItem Content="Health" Tag="Health" />
          <NavigationViewItem Content="Recovery" Tag="Recovery" />
          <NavigationViewItem Content="Storage" Tag="Storage" />
          <NavigationViewItem Content="Installed apps" Tag="Apps" />
          <NavigationViewItem Content="System information" Tag="SystemInfo" />
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
          <Border Background="{StaticResource SiftCardBrush}" BorderBrush="{StaticResource SiftLineBrush}" BorderThickness="1"
                  CornerRadius="9" Padding="13,10" Margin="4,10,4,16">
            <TextBlock x:Name="ElevationText" Style="{StaticResource TypeMetaStyle}" FontWeight="SemiBold" />
          </Border>
        </NavigationView.PaneFooter>
        <NavigationView.Content>
          <ContentControl x:Name="WorkspaceHost" Margin="34,26,34,26"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </NavigationView.Content>
      </NavigationView>

      <controls:ActivityConsolePanel x:Name="ConsolePanel" Grid.Column="1" Canvas.ZIndex="20" />
    </Grid>
  </Grid>
</Window>
