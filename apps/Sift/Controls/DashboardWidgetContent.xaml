<UserControl
    x:Class="Sift.WinUI.Controls.DashboardWidgetContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI">
  <Grid x:Name="RootGrid" RowSpacing="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="ValueText" Style="{StaticResource TypeMetricValueStyle}" FontSize="18" Text="—" />
    <TextBlock x:Name="DetailText" Grid.Row="1" Style="{StaticResource TypeMetaStyle}"
               Text="Waiting for the first sample…" TextWrapping="Wrap" MaxLines="3" />
    <Grid Grid.Row="2" MinHeight="0">
      <lvc:CartesianChart x:Name="MetricChart" Visibility="Collapsed" LegendPosition="Hidden" Background="Transparent" />
      <ListView x:Name="ItemsList" Visibility="Collapsed" SelectionMode="Single"
                HorizontalContentAlignment="Stretch" IsItemClickEnabled="False"
                SelectionChanged="ItemsList_SelectionChanged">
        <ListView.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" Style="{StaticResource TypeMetaStyle}" /></DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <TextBlock x:Name="EmptyText" Text="No data available" Visibility="Collapsed"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource TypeMetaStyle}" />
    </Grid>
    <StackPanel x:Name="ActionRow" Grid.Row="3" Orientation="Horizontal" Spacing="6">
      <controls:SiftIconButton x:Name="ActionButton" Visibility="Collapsed" HorizontalAlignment="Left" MinHeight="32" Padding="10,4"
              Style="{StaticResource SecondaryButtonStyle}" Click="ActionButton_Click" />
      <controls:SiftIconButton x:Name="SecondaryActionButton" Visibility="Collapsed" HorizontalAlignment="Left" MinHeight="32" Padding="10,4"
              Style="{StaticResource SecondaryButtonStyle}" Click="SecondaryActionButton_Click" />
    </StackPanel>
  </Grid>
</UserControl>
