<UserControl
    x:Class="Sift.WinUI.Controls.DockHostControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls">
  <Grid RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="CaptionText" Style="{StaticResource TypePanelTitleStyle}" VerticalAlignment="Center"
                 Text="Sensor graphs" />
      <TextBlock x:Name="CountText" Grid.Column="1" Style="{StaticResource TypeMetaStyle}"
                 VerticalAlignment="Center" />
      <controls:SiftIconButton x:Name="TidyButton" Grid.Column="2" Icon="Tidy" Label="Tidy"
              Click="TidyButton_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6"
              AutomationProperties.Name="Tidy sensor graph tiles" />
      <controls:SiftIconButton x:Name="PopOutButton" Grid.Column="3" Icon="PopOut" Label="Pop out"
              Click="PopOutButton_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6"
              AutomationProperties.Name="Pop out sensor graph board" />
    </Grid>
    <Grid Grid.Row="1">
      <ContentPresenter x:Name="RootPresenter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <Grid x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="2*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Column="1" Background="#44A9BB98" BorderBrush="{StaticResource SiftSuccessBrush}" BorderThickness="1" />
        <Border Grid.Row="1" Background="#44A9BB98" BorderBrush="{StaticResource SiftSuccessBrush}" BorderThickness="1" />
        <Border Grid.Row="1" Grid.Column="1" Background="#66D89462" BorderBrush="{StaticResource SiftAccentBrush}" BorderThickness="2" />
        <Border Grid.Row="1" Grid.Column="2" Background="#44A9BB98" BorderBrush="{StaticResource SiftSuccessBrush}" BorderThickness="1" />
        <Border Grid.Row="2" Grid.Column="1" Background="#44A9BB98" BorderBrush="{StaticResource SiftSuccessBrush}" BorderThickness="1" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
