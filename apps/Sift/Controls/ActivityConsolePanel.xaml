<UserControl
    x:Class="Sift.WinUI.Controls.ActivityConsolePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls">
  <Border Background="{StaticResource SiftPanelBrush}"
          BorderBrush="{StaticResource SiftLineStrongBrush}"
          BorderThickness="1,0,0,0"
          Padding="18,20,18,16">
    <Grid RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock Text="Activity console" FontSize="20" FontWeight="SemiBold"
                     Foreground="{StaticResource SiftTextBrush}" />
          <TextBlock Text="Events from this session"
                     FontSize="11" Foreground="{StaticResource SiftMutedBrush}" />
        </StackPanel>
        <controls:SiftIconButton Grid.Column="1" Icon="Hide" Label="Hide" Click="HideButton_Click"
                Style="{StaticResource SecondaryButtonStyle}"
                AutomationProperties.Name="Hide activity console" />
      </Grid>

      <Grid Grid.Row="1" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="132" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="FilterBox" PlaceholderText="Filter activity…"
                 TextChanged="FilterBox_TextChanged"
                 AutomationProperties.Name="Filter activity console" />
        <ComboBox x:Name="SeverityFilter" Grid.Column="1" SelectedIndex="0"
                  SelectionChanged="SeverityFilter_SelectionChanged"
                  AutomationProperties.Name="Activity severity filter">
          <ComboBoxItem Content="All levels" />
          <ComboBoxItem Content="Trace" />
          <ComboBoxItem Content="Info" />
          <ComboBoxItem Content="Warning" />
          <ComboBoxItem Content="Error" />
        </ComboBox>
      </Grid>

      <Grid Grid.Row="2" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource StatusPillStyle}" HorizontalAlignment="Left">
          <TextBlock Text="●  CAPTURING" Foreground="{StaticResource SiftSuccessBrush}"
                     FontSize="10" FontWeight="SemiBold" />
        </Border>
        <controls:SiftIconButton Grid.Column="1" Icon="Copy" Label="Copy visible" Click="CopyButton_Click"
                Style="{StaticResource SecondaryButtonStyle}"
                AutomationProperties.Name="Copy visible activity entries" />
        <controls:SiftIconButton Grid.Column="2" Icon="Clear" Label="Clear" Click="ClearButton_Click"
                Style="{StaticResource SecondaryButtonStyle}"
                AutomationProperties.Name="Clear session activity entries" />
      </Grid>

      <Border Grid.Row="3" Background="{StaticResource SiftBackgroundBrush}"
              BorderBrush="{StaticResource SiftLineBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
          <ListView x:Name="ConsoleList" SelectionMode="None"
                    AutomationProperties.Name="Application activity entries">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel Padding="11,10" Spacing="5"
                            BorderBrush="{StaticResource SiftLineBrush}" BorderThickness="0,0,0,1">
                  <TextBlock Text="{Binding Header}" FontFamily="Cascadia Mono" FontSize="9"
                             Foreground="{StaticResource SiftSubtleBrush}" />
                  <TextBlock Text="{Binding Message}" FontFamily="Cascadia Mono" FontSize="11"
                             TextWrapping="Wrap" Foreground="{StaticResource SiftTextBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Spacing="6" Margin="20">
            <controls:SiftIcon Kind="EmptyActivity" Size="26" Foreground="{StaticResource SiftSubtleBrush}" />
            <TextBlock Text="No matching activity" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Foreground="{StaticResource SiftTextBrush}" />
            <TextBlock Text="Operations and navigation events appear here as they happen."
                       MaxWidth="240" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource SiftMutedBrush}" FontSize="11" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="ConsoleCountText" FontSize="10" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                   Foreground="{StaticResource SiftMutedBrush}" />
        <ToggleSwitch x:Name="AutoScrollToggle" Grid.Column="1" VerticalAlignment="Center"
                      IsOn="True" OnContent="Following" OffContent="Follow"
                      AutomationProperties.Name="Follow newest activity" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
