<UserControl
    x:Class="Sift.WinUI.Controls.StorageTreemapControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls">
  <Grid Background="{StaticResource SiftBackgroundBrush}">
    <Canvas x:Name="Surface" SizeChanged="Surface_SizeChanged" />
    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="7" Margin="24">
      <controls:SiftIcon Kind="EmptyStorage" Size="28" Foreground="{StaticResource SiftSubtleBrush}" />
      <TextBlock x:Name="EmptyTitle" Text="Scan a folder or drive" FontWeight="SemiBold"
                 Foreground="{StaticResource SiftTextBrush}" HorizontalAlignment="Center" />
      <TextBlock x:Name="EmptyDetail" Text="The disk map appears here after a scan."
                 MaxWidth="380" TextAlignment="Center" TextWrapping="Wrap"
                 Foreground="{StaticResource SiftMutedBrush}" />
    </StackPanel>
  </Grid>
</UserControl>
