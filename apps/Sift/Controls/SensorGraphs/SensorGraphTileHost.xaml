<UserControl
    x:Class="Sift.WinUI.Controls.SensorGraphTileHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI">
  <Border x:Name="CardBorder" Style="{StaticResource CardBorderStyle}" Padding="8,7"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid RowSpacing="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:SiftIconButton x:Name="DragHandle" Icon="Drag" Style="{StaticResource SiftChromeIconButtonStyle}"
                AutomationProperties.Name="Move sensor graph tile"
                PointerPressed="DragHandle_PointerPressed" PointerMoved="DragHandle_PointerMoved"
                PointerReleased="DragHandle_PointerReleased" PointerCanceled="DragHandle_PointerCanceled"
                PointerCaptureLost="InteractionHandle_PointerCaptureLost" />
        <StackPanel x:Name="TitlePanel" Grid.Column="1" Spacing="0" VerticalAlignment="Center"
                    PointerPressed="DragHandle_PointerPressed" PointerMoved="DragHandle_PointerMoved"
                    PointerReleased="DragHandle_PointerReleased" PointerCanceled="DragHandle_PointerCanceled"
                    PointerCaptureLost="InteractionHandle_PointerCaptureLost">
          <TextBlock x:Name="TitleText" Style="{StaticResource TypePanelTitleStyle}" FontSize="12"
                     TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
          <TextBlock x:Name="ValueText" Style="{StaticResource TypeMetaStyle}" FontFamily="Cascadia Mono"
                     FontSize="11" LineHeight="14" IsHitTestVisible="False"/>
        </StackPanel>
        <controls:SiftIconButton x:Name="CloseButton" Grid.Column="2" Icon="Close" Style="{StaticResource SiftChromeIconButtonStyle}"
                Click="CloseButton_Click"
                AutomationProperties.Name="Close sensor graph" />
        <controls:SiftIconButton x:Name="ResizeHandle" Grid.Column="3" Icon="Resize" Style="{StaticResource SiftChromeIconButtonStyle}"
                AutomationProperties.Name="Resize sensor graph tile"
                PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved"
                PointerReleased="ResizeHandle_PointerReleased" PointerCanceled="ResizeHandle_PointerCanceled"
                PointerCaptureLost="InteractionHandle_PointerCaptureLost" />
      </Grid>
      <lvc:CartesianChart x:Name="Chart" Grid.Row="1" Background="Transparent"
                          AutomationProperties.Name="Sensor graph history" />
    </Grid>
  </Border>
</UserControl>
