<UserControl
    x:Class="Sift.WinUI.Controls.GraphBoardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sift.WinUI.Controls">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <controls:DashboardGridPanel x:Name="TileGrid" Columns="4" RowHeight="88" Spacing="10" />
        <Border x:Name="SnapGhost"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="12"
                BorderThickness="2"
                BorderBrush="{StaticResource SiftSuccessBrush}"
                Background="#33A9BB98" />
        <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="6" Margin="16">
          <TextBlock Text="No sensor graphs pinned" Style="{StaticResource TypeSectionTitleStyle}" HorizontalAlignment="Center" />
          <TextBlock Text="Use Graph on a sensor to add up to 32 live charts." Style="{StaticResource TypeMetaStyle}"
                     TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
