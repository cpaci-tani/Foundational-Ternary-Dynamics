<Project>
  <PropertyGroup>
    <SiftBuildOutputCleaner>$(MSBuildThisFileDirectory)Sift\scripts\clean-build-output.ps1</SiftBuildOutputCleaner>
  </PropertyGroup>

  <!-- Enforce the documented zero-warning build contract for Release across every Sift project,
       rather than leaving it a convention nothing checks. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Enforce that Sift.Core stays presentation-neutral. The architecture depends on Core never
       referencing WinUI, the Windows App SDK, or chart controls, and never opting into WPF/WinForms;
       this fails the build if a new reference erodes that boundary instead of trusting a convention.
       Framework facades such as System.Windows/WindowsBase are always present on the net8.0-windows
       targeting pack and are not WPF unless UseWPF is set, so they are gated by the UseWPF check
       rather than by an assembly-name match that would false-positive. -->
  <Target Name="GuardCorePresentationPurity"
          AfterTargets="ResolveReferences"
          Condition="'$(MSBuildProjectName)' == 'Sift.Core'">
    <Error Condition="'$(UseWPF)' == 'true' Or '$(UseWindowsForms)' == 'true'"
           Text="Sift.Core must remain presentation-neutral: UseWPF/UseWindowsForms must not be enabled." />
    <ItemGroup>
      <_ForbiddenCoreReference Include="@(ReferencePath)"
        Condition="$([System.String]::new('%(FileName)').StartsWith('Microsoft.UI'))
                Or $([System.String]::new('%(FileName)').StartsWith('Microsoft.WindowsAppSDK'))
                Or $([System.String]::new('%(FileName)').StartsWith('LiveChartsCore'))
                Or $([System.String]::new('%(FileName)').StartsWith('SkiaSharp'))
                Or $([System.String]::new('%(FileName)').StartsWith('WinUI'))" />
    </ItemGroup>
    <Error Condition="'@(_ForbiddenCoreReference)' != ''"
           Text="Sift.Core must remain presentation-neutral but resolved these presentation references: @(_ForbiddenCoreReference->'%(FileName)')." />
  </Target>

  <Target Name="CleanSiftBuildOutput"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipSiftBuildOutputClean)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(SiftBuildOutputCleaner)&quot; -ProjectDirectory &quot;$(MSBuildProjectDirectory)&quot; -OutputDirectory &quot;$(OutDir).&quot;" />
  </Target>
</Project>
