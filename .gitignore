# Scripts result artifacts (regenerable from each generator script).
# NOTE: these globs match only direct children; the whole-dir rule in the
# 2026-06-11 cleanup block below also catches nested result subtrees.
scripts/exploration/results/*.csv
scripts/exploration/results/*.md
scripts/exploration/results/*.txt
scripts/experiments/results/
scripts/visualization/results/3d_models/

# === 2026-06-11 professional public-facing cleanup ===
# Campaign/exploration outputs are local-only by policy: reproducibility comes
# from the pre-registration git tags + frozen script SHAs (REF_PREREGISTER_
# MANIFEST.md), not from committing regenerable data dumps. Source scripts
# (.py/.c) and the curated scripts/exploration/outputs/ keepers stay tracked.

# Root-level run scratch / telemetry / plots (campaign byproducts)
/*_telemetry.csv
/*_out.txt
/*.png
/clean_gitignore.py

# Top-level exploration run dumps + nested result subtrees
scripts/exploration/results/
scripts/exploration/*.txt
scripts/exploration/*.csv
scripts/exploration/*.png

# Compiled Windows binaries.
*.exe

# Ignore all dotfiles (private/hidden files)
.*
# Keep Git tracking configuration active
!.gitattributes
!.github/
!.githooks/

# Generated web documentation renders. Keep Markdown sources tracked.
engine/web/docs/*.html
engine/web/docs/*_files/

# Ignore run_wsl.sh script
run_wsl.sh
.gitignore

# ClearWin keeps scoped ignore rules beside its Windows projects. The global
# dotfile rule must not hide those two tracked policy files.
!apps/.gitignore
!apps/ClearWin/.gitignore
traj_koopman_A14.csv
traj_temp_64.csv
traj_temp.csv
traj_temp_128.csv
.gitignore

# ClearWin keeps scoped ignore rules beside its Windows projects. This later
# exception is intentionally after the legacy catch-all above.
!apps/.gitignore
!apps/ClearWin/.gitignore

# 18-pt stencil moment intermediate (regenerable via explr_stencil18_moments.py)
scripts/proofs/_stencil18_moments.txt
# LGF control-lattice moment intermediates (regenerable via explr_*_moments.py)
scripts/proofs/_square2d_moments.txt
scripts/proofs/_sc3d_moments.txt
# two-loop BCC sunset c_N sequence (regenerable via lattice_two_loop_bcc_series.py)
scripts/exploration/_bcc_sunset_cN.txt
scripts/exploration/_bcc_sunset_cN_600.txt
# mod-p c_N (regenerable via lattice_two_loop_bcc_modp.py) + scratch
scripts/exploration/_bcc_sunset_cN_modp_*.txt
scripts/exploration/_modp_test*.txt

# Local app workspaces (math-studio etc.) are not tracked. Written as `apps/*`
# rather than `apps/` on purpose: git cannot re-include anything beneath an
# excluded *directory*, so a bare `apps/` would silently kill the scoped
# policy-file exceptions above (!apps/.gitignore, !apps/ClearWin/.gitignore).
apps/*
!apps/.gitignore
!apps/ClearWin/
apps/ClearWin/*
!apps/ClearWin/.gitignore

# Stray MSVC object spill at the repo root.
# `cl` invoked with cwd=<repo root> (rather than inside engine/build) drops
# .obj next to the sources instead of into the build tree. engine/build*/ is
# already ignored; this catches the mis-run case. Added 2026-07-27.
/*.obj
/*.pdb
/*.ilk
/*.exp
