.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
nul

# Archives (keep source, not zips)
*.zip

# Temporary files
*.tmp
*.temp
*~

# Phase B engine test artifacts (root-level JSON outputs from dump_*.cpp / test_*.cpp;
