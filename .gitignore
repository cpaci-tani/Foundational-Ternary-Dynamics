# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
# Vendored Three.js keeps the npm package layout, which includes a directory
# literally named build/ — re-include it (see engine/web/js/vendor/three/README.md)
!engine/web/js/vendor/three/build/

# Quarto build artifacts
dissemination/manuscript/.quarto/
dissemination/manuscript/_book/
dissemination/manuscript/_webbook/
dissemination/manuscript/*_files/
*.quarto_ipynb

.claude

# AI agent state directories
.brain/
.memory/
.hermes/
.agents/

# Generated output files
output/
*_output.txt

# One-off root cleanup/generation dumps
/diff.txt
/theorems.txt
/filtered_theorems.txt
/uv.lock

# LaTeX auxiliary files
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg

# folders
medium_posts/
dissemination/media/
archive/
docs/internal/
docs/superpowers/
docs/articles/

